      "download_page_url": "https://github.com/git-for-windows/git/releases",
      "icon_file": "git.png",
      "icon_text": "Git",
      "icon_background": "#F05032",
      "installation_notes": "下载后运行安装向导，按需选择默认编辑器、PATH 与换行符转换选项。当前版本提供 x64 与 ARM64 安装包，不再提供 32 位安装包。",
      "features": [
        "完整的 Git 命令行工具",
        "内置 Git Bash 与 Git GUI",
        "支持 HTTPS 与 SSH 访问仓库",
        "包含 Git 凭据管理器"
      ],
      "tags": [
        "版本控制",
        "Git",
        "命令行",
        "开源"
      ],
      "is_recommended": true,
      "sort_order": 100,
      "download_provider": "git",
      "provider_spec": {
        "repo": "git-for-windows/git",
        "tag_prefix": "v",
        "assets": [
          {
            "pattern": "Git-\\d+(?:\\.\\d+)+-64-bit\\.exe",
            "architecture": "x64"
          },
          {
            "pattern": "Git-\\d+(?:\\.\\d+)+-arm64\\.exe",
            "architecture": "arm64"
          }
        ]
      },
      "latest_release_id": null,
      "releases": [],
