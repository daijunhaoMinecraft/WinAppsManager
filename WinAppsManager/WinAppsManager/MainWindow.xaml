<Window x:Class="WinAppsManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinAppsManager"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:TitleBar.Height="36"
        mc:Ignorable="d"
        Title="WinAppsManager" Height="760" Width="1080"
        MinHeight="560" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Wam.PageBackgroundBrush}"
        PreviewKeyDown="MainWindow_OnPreviewKeyDown">
    <ui:NavigationView x:Name="NavView"
                       PaneTitle="WinAppsManager"
                       IsSettingsVisible="False"
                       PaneDisplayMode="Left"
                       IsPaneOpen="True"
                       OpenPaneLength="220"
                       ItemInvoked="NavigationView_OnItemInvoked"
                       SelectionChanged="NavigationView_OnSelectionChanged">
        <ui:NavigationView.MenuItems>
            <ui:NavigationViewItem x:Name="SoftwareNavigationItem" Content="软件列表" Tag="1" IsExpanded="True">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Apps_20_Regular}"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="DownloadsNavigationItem" Content="下载中心" Tag="3">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ArrowDownload_24_Regular}"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="UninstallNavigationItem" Content="卸载软件" Tag="4" IsExpanded="True">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Delete_20_Regular}"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="SettingsNavigationItem" Content="设置" Tag="2">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Settings_20_Regular}"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
        </ui:NavigationView.MenuItems>
        <!-- 页面容器分三层：
             1) 最外层 Grid 负责裁剪，页面过渡时的位图位移不会画到左侧导航栏上；
             2) PageHost 承载真实页面，过渡时它自己淡入/滑入（位图缓存保证帧率）；
             3) OutgoingSnapshot 是旧页面的位图：旧页面已离开视觉树，只能靠快照滑出/淡出。
             若把裁剪和 RenderTransform 放在同一个元素上，WPF 会按未变换的布局边界裁剪再整体平移，
             滑入的内容会画到导航栏上方，因此必须分层。 -->
        <Grid Background="{DynamicResource Wam.PageBackgroundBrush}" ClipToBounds="True">
            <Grid x:Name="PageHost">
                <Frame x:Name="FrameView" NavigationUIVisibility="Hidden"/>
            </Grid>

            <!-- 位图缩放质量用 LowQuality（双线性）：过渡中位图一直在移动并淡出，
                 高分辨率 Fant 滤波的每帧开销明显更高，观感却没有区别。 -->
            <Image x:Name="OutgoingSnapshot"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"
                   Stretch="Fill"
                   RenderOptions.BitmapScalingMode="LowQuality"
                   Panel.ZIndex="10"/>
        </Grid>
    </ui:NavigationView>
</Window>
