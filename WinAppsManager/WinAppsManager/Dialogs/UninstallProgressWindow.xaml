<Window x:Class="WinAppsManager.Dialogs.UninstallProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Title="正在卸载"
        Width="720"
        Height="590"
        MinHeight="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Closing="Window_OnClosing"
        Loaded="Window_OnLoaded"
        AutomationProperties.Name="卸载进度">
    <Grid Margin="20">
        <Border Background="{DynamicResource Wam.CardBackgroundBrush}"
                BorderBrush="{DynamicResource Wam.CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="24,22,24,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" Opacity="0.28" ShadowDepth="6" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="10"
                            Background="{DynamicResource Wam.AccentSoftBrush}"
                            VerticalAlignment="Top" Margin="0,0,13,0">
                        <Grid>
                            <ui:ProgressRing x:Name="BusyRing" IsActive="True" IsIndeterminate="True"
                                             Width="24" Height="24"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource Wam.AccentBrush}"/>
                            <ui:FontIcon x:Name="CompleteIcon" Icon="{x:Static ui:FluentSystemIcons.Checkmark_20_Regular}"
                                         FontSize="20" Visibility="Collapsed"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource Wam.SuccessBrush}"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="正在卸载"
                                   FontSize="21" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                        <TextBlock Text="请按顺序完成每个软件的卸载向导。需要中止时可以点击“停止卸载”，本应用会结束正在运行的卸载程序及其子进程。"
                                   TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource Wam.AccentSoftBrush}"
                        CornerRadius="8" Padding="12,9" Margin="0,16,0,0">
                    <TextBlock Text="停止卸载会终止厂商卸载程序及其子进程，该软件可能停留在部分卸载的状态，需要重新安装或手动清理。"
                               TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Wam.DangerBrush}"/>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,18,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CurrentText" Text="准备开始…"
                                   FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                        <TextBlock x:Name="ProgressCountText" Grid.Column="1" Margin="12,0,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    </Grid>
                    <ProgressBar x:Name="OverallProgress" Height="7" Minimum="0" Maximum="1"
                                 Value="0" Margin="0,9,0,0"
                                 Foreground="{DynamicResource Wam.AccentBrush}"/>
                </StackPanel>

                <TextBlock Grid.Row="3" Text="执行结果"
                           FontSize="12" FontWeight="SemiBold" Margin="0,18,0,8"
                           Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>

                <Border Grid.Row="4" Background="{DynamicResource Wam.SubtleBackgroundBrush}"
                        CornerRadius="8" Padding="10,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Wam.CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource Wam.CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="7"
                                            Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" CornerRadius="6"
                                                    VerticalAlignment="Center" Margin="0,0,9,0">
                                                <Grid>
                                                    <Border CornerRadius="6" Background="{Binding App.AvatarBackground}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding App.HasIcon}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding App.Initial}" FontSize="10"
                                                                   FontWeight="Bold" Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Image Source="{Binding App.IconSource}" Width="20" Height="20"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AppName}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding DetailText}" FontSize="11"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" CornerRadius="5" Padding="7,3"
                                                    VerticalAlignment="Top" Margin="10,0,0,0"
                                                    Background="{DynamicResource Wam.AccentSoftBrush}">
                                                <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Wam.SuccessBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Wam.DangerBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Canceled">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Wam.TextSecondaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="5" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SummaryText" Text="正在启动卸载程序…"
                               TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                               Margin="0,0,14,0"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    <Button x:Name="StopButton" Grid.Column="1" Content="停止卸载"
                            MinWidth="96" Height="36" Padding="16,0"
                            Click="StopButton_OnClick"
                            AutomationProperties.Name="停止当前卸载流程"/>
                    <Button x:Name="CloseButton" Grid.Column="2" Content="完成"
                            MinWidth="92" Height="36" Padding="16,0" Margin="10,0,0,0"
                            Visibility="Collapsed" Click="CloseButton_OnClick"
                            AutomationProperties.Name="关闭卸载进度窗口"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
