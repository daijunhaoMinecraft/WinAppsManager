<Window x:Class="WinAppsManager.Dialogs.ScreenshotViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Title="截图预览"
        Width="1024" Height="720" MinWidth="560" MinHeight="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        AutomationProperties.Name="截图预览窗口">
    <Grid Margin="20">
        <Border Background="{DynamicResource Wam.PageBackgroundBrush}"
                BorderBrush="{DynamicResource Wam.CardBorderBrush}"
                BorderThickness="1" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" Opacity="0.32" ShadowDepth="6" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="18,12,18,0" Background="Transparent"
                      MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitleText" Text="截图预览" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                        <Border Background="{DynamicResource Wam.AccentSoftBrush}" CornerRadius="4"
                                Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="CounterText" FontSize="11"
                                       Foreground="{DynamicResource Wam.AccentBrush}"/>
                        </Border>
                    </StackPanel>
                    <Button x:Name="CloseButton" Grid.Column="1" Content="✕" Width="34" Height="34"
                            Padding="0" FontSize="13"
                            Click="CloseButton_OnClick" ToolTip="关闭 (Esc)"
                            AutomationProperties.Name="关闭截图预览"/>
                </Grid>

                <Grid Grid.Row="1" Margin="18,12,18,8">
                    <Border Background="{DynamicResource Wam.SubtleBackgroundBrush}" CornerRadius="10"
                            ClipToBounds="True">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="16"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <!-- 视频播放器：源为后端代理地址，未播放前 Collapsed，下面的缩略图继续充当海报。 -->
                            <MediaElement x:Name="VideoPlayer" Margin="16" Stretch="Uniform"
                                          LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                          ScrubbingEnabled="True" Volume="0.8"
                                          Visibility="Collapsed"
                                          MediaOpened="VideoPlayer_OnMediaOpened"
                                          MediaEnded="VideoPlayer_OnMediaEnded"
                                          MediaFailed="VideoPlayer_OnMediaFailed"
                                          BufferingStarted="VideoPlayer_OnBufferingStarted"
                                          BufferingEnded="VideoPlayer_OnBufferingEnded"/>

                            <StackPanel x:Name="StatusPanel" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ui:ProgressRing x:Name="LoadingRing" IsActive="False" IsIndeterminate="True"
                                                 Width="36" Height="36" HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource Wam.AccentBrush}"
                                                 Background="Transparent"/>
                                <TextBlock x:Name="StatusText" Margin="0,10,0,0" FontSize="12"
                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380"
                                           Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                            </StackPanel>

                            <Button x:Name="CenterPlayButton" Width="84" Height="84" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Collapsed" Click="CenterPlayButton_OnClick"
                                    ToolTip="播放 (Space)" AutomationProperties.Name="播放视频">
                                <Grid>
                                    <Border Background="{DynamicResource Wam.AccentBrush}" CornerRadius="42"
                                            Opacity="0.92"/>
                                    <TextBlock Text="▶" FontSize="32" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="5,0,0,0"/>
                                </Grid>
                            </Button>

                            <StackPanel x:Name="VideoErrorPanel" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" MaxWidth="440" Margin="40,0"
                                        Visibility="Collapsed">
                                <TextBlock Text="视频暂时无法播放" FontSize="16" FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource Wam.DangerBrush}"/>
                                <TextBlock Text="可能是视频格式不受支持或连接中断。可点击下方“在浏览器打开”，用系统浏览器播放同一视频。"
                                           FontSize="11.5" TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0"
                                           Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                            </StackPanel>

                            <Border x:Name="VideoBadge" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="14" Background="{DynamicResource Wam.CardBackgroundBrush}"
                                    CornerRadius="5" Padding="9,4" Visibility="Collapsed">
                                <TextBlock Text="▶ 视频预览" FontSize="11"
                                           Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                            </Border>
                            <Button x:Name="PreviousButton" Content="‹" Width="42" Height="64" FontSize="24"
                                    Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="12,0,0,0" Click="PreviousButton_OnClick" ToolTip="上一个 (←)"
                                    AutomationProperties.Name="上一个"/>
                            <Button x:Name="NextButton" Content="›" Width="42" Height="64" FontSize="24"
                                    Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,12,0" Click="NextButton_OnClick" ToolTip="下一个 (→)"
                                    AutomationProperties.Name="下一个"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 视频控件条：仅当条目是视频且能构造出后端代理地址时显示。 -->
                <Border x:Name="VideoControls" Grid.Row="2" Margin="18,0,18,2" Padding="14,10"
                        Background="{DynamicResource Wam.CardBackgroundBrush}"
                        BorderBrush="{DynamicResource Wam.CardBorderBrush}" BorderThickness="1"
                        CornerRadius="9" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PlayPauseButton" Width="36" Height="36" Padding="0"
                                    Click="PlayPauseButton_OnClick" ToolTip="播放 / 暂停 (Space)"
                                    AutomationProperties.Name="播放或暂停视频">
                                <Grid>
                                    <TextBlock x:Name="PlayIcon" Text="▶" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="1,0,0,0"
                                               Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                                    <StackPanel x:Name="PauseIcon" Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="Collapsed">
                                        <Border Width="4" Height="14" CornerRadius="1" Margin="1,0"
                                                Background="{DynamicResource Wam.TextPrimaryBrush}"/>
                                        <Border Width="4" Height="14" CornerRadius="1" Margin="1,0"
                                                Background="{DynamicResource Wam.TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Slider x:Name="ProgressSlider" Grid.Column="1" Margin="12,0,12,0"
                                    VerticalAlignment="Center" Minimum="0" Maximum="1" Value="0"
                                    IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10"
                                    AutomationProperties.Name="视频播放进度"/>
                            <TextBlock x:Name="TimeText" Grid.Column="2" Text="0:00 / 0:00" MinWidth="96"
                                       FontSize="11.5" TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Margin="0,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:ProgressRing x:Name="VideoLoadingRing" IsActive="False" IsIndeterminate="True"
                                                 Width="18" Height="18" Visibility="Collapsed"
                                                 Foreground="{DynamicResource Wam.AccentBrush}"
                                                 Background="Transparent"/>
                                <TextBlock x:Name="VideoStatusText" Grid.Column="1" Margin="6,0,0,0"
                                           FontSize="11.5" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                            </Grid>
                            <Button x:Name="MuteButton" Grid.Column="1" Content="静音" MinWidth="72" Height="30"
                                    Padding="12,0" Click="MuteButton_OnClick"
                                    ToolTip="静音 / 取消静音" AutomationProperties.Name="静音"/>
                            <Button x:Name="BrowserButton" Grid.Column="2" Content="在浏览器打开" Height="30"
                                    Padding="12,0" Margin="8,0,0,0" Click="BrowserButton_OnClick"
                                    ToolTip="用系统浏览器打开后端代理的视频地址（内置播放器失败时的兜底）"
                                    AutomationProperties.Name="在浏览器中打开视频"/>
                        </Grid>
                    </Grid>
                </Border>

                <TextBlock x:Name="HintText" Grid.Row="3" Margin="18,6,18,14" FontSize="11"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Text="← / → 切换，Home / End 跳到首尾，Esc 关闭"
                           Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
