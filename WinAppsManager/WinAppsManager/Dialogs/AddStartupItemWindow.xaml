<Window x:Class="WinAppsManager.Dialogs.AddStartupItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Title="添加自启动项"
        Width="580"
        SizeToContent="Height"
        MaxHeight="760"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="添加自启动项">
    <Grid Margin="20">
        <Border Background="{DynamicResource Wam.CardBackgroundBrush}"
                BorderBrush="{DynamicResource Wam.CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="24,22,24,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" Opacity="0.28" ShadowDepth="6" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="10"
                            Background="{DynamicResource Wam.AccentSoftBrush}"
                            VerticalAlignment="Top" Margin="0,0,13,0">
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Add_20_Regular}"
                                     FontSize="20"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource Wam.AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="添加自启动项"
                                   FontSize="21" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                        <TextBlock Text="写入 Run/RunOnce 注册表键、开始菜单启动文件夹或任务计划程序"
                                   FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,18,0,0">
                    <TextBlock Text="启动类型" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"
                               Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                    <ComboBox x:Name="StartTypeCombo" Height="34" Padding="10,0"
                              HorizontalAlignment="Stretch"
                              VerticalContentAlignment="Center"
                              SelectionChanged="StartTypeCombo_OnSelectionChanged"
                              AutomationProperties.Name="启动类型"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <TextBlock Text="程序路径" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"
                               Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathBox" Height="34" Padding="10,0" FontSize="12.5"
                                 VerticalContentAlignment="Center"
                                 TextChanged="PathBox_OnTextChanged"
                                 LostFocus="PathBox_OnLostFocus"
                                 AutomationProperties.Name="要自启动的程序路径"/>
                        <Button Grid.Column="1" Content="浏览…" Height="34" Padding="14,0"
                                Margin="8,0,0,0" Click="BrowseButton_OnClick"
                                AutomationProperties.Name="浏览选择程序"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock Text="名称" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"
                               Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                    <TextBox x:Name="NameBox" Height="34" Padding="10,0" FontSize="12.5"
                             VerticalContentAlignment="Center"
                             AutomationProperties.Name="自启动项名称"
                             ToolTip="也是 Run 键的值名 / 快捷方式文件名 / 计划任务名。留空时按程序自动生成"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,14,0,0">
                    <TextBlock Text="启动参数（可选）" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"
                               Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                    <TextBox x:Name="ArgumentsBox" Height="34" Padding="10,0" FontSize="12.5"
                             VerticalContentAlignment="Center"
                             AutomationProperties.Name="启动参数"
                             ToolTip="例如 --minimized，会原样追加在程序路径后面"/>

                    <Border x:Name="HintPanel" Background="{DynamicResource Wam.SubtleBackgroundBrush}"
                            CornerRadius="8" Padding="12,10" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="写入位置" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                            <TextBlock x:Name="HintText" FontSize="11.5" Margin="0,3,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ErrorPanel" Visibility="Collapsed"
                            Background="{DynamicResource Wam.AccentSoftBrush}"
                            CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Warning_20_Regular}"
                                         FontSize="16" Margin="0,1,9,0" VerticalAlignment="Top"
                                         Foreground="{DynamicResource Wam.DangerBrush}"/>
                            <TextBlock x:Name="ErrorText" Grid.Column="1" TextWrapping="Wrap"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Wam.DangerBrush}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,20,0,0">
                    <Button Content="取消" MinWidth="86" Height="36" Padding="16,0"
                            IsCancel="True" Click="CancelButton_OnClick"
                            AutomationProperties.Name="取消添加"/>
                    <Button x:Name="ConfirmButton" Content="添加" MinWidth="104" Height="36"
                            Padding="16,0" Margin="10,0,0,0"
                            Style="{StaticResource Wam.AccentButtonStyle}"
                            Click="ConfirmButton_OnClick"
                            AutomationProperties.Name="确认添加自启动项"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
