<Window x:Class="WinAppsManager.Dialogs.UninstallConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Title="确认卸载"
        Width="560"
        SizeToContent="Height"
        MaxHeight="650"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="确认卸载软件">
    <Grid Margin="20">
        <Border Background="{DynamicResource Wam.CardBackgroundBrush}"
                BorderBrush="{DynamicResource Wam.CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="24,22,24,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" Opacity="0.28" ShadowDepth="6" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="10"
                            Background="{DynamicResource Wam.AccentSoftBrush}"
                            VerticalAlignment="Top" Margin="0,0,13,0">
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Delete_20_Regular}"
                                     FontSize="20"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource Wam.DangerBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="确认卸载这些软件？"
                                   FontSize="21" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                        <TextBlock x:Name="SummaryText"
                                   FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource Wam.AccentSoftBrush}"
                        CornerRadius="8" Padding="13,11" Margin="0,18,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Warning_20_Regular}"
                                     FontSize="16" Margin="0,2,10,0"
                                     VerticalAlignment="Top"
                                     Foreground="{DynamicResource Wam.DangerBrush}"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="卸载过程中可以随时停止，但可能留下部分卸载的软件"
                                       FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource Wam.DangerBrush}"/>
                            <TextBlock Text="进度窗口提供“停止卸载”，会终止厂商卸载程序及其子进程；已经写入磁盘的改动不会自动回滚。请先保存工作并关闭正在使用这些软件的程序。"
                                       TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2">
                    <Border x:Name="StoreNoticePanel" Visibility="Collapsed"
                            Background="{DynamicResource Wam.SubtleBackgroundBrush}"
                            CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="所选包含 Microsoft Store 应用"
                                       FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                            <TextBlock Text="商店应用只会从当前 Windows 用户卸载，不影响其他用户；该应用的本地用户数据会一并删除。"
                                       TextWrapping="Wrap" FontSize="11.5" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                            <TextBlock x:Name="RelatedStoreNotice" Visibility="Collapsed"
                                       TextWrapping="Wrap" FontSize="11.5" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="将按顺序启动以下卸载程序："
                               FontSize="12" FontWeight="SemiBold" Margin="0,14,0,7"
                               Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                </StackPanel>

                <Border Grid.Row="3" Background="{DynamicResource Wam.SubtleBackgroundBrush}"
                        CornerRadius="8" Padding="12,10" MaxHeight="190">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ApplicationsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" CornerRadius="6"
                                                VerticalAlignment="Center" Margin="0,0,9,0">
                                            <Grid>
                                                <Border CornerRadius="6" Background="{Binding AvatarBackground}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Initial}" FontSize="10"
                                                               FontWeight="Bold" Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <Image Source="{Binding IconSource}" Width="18" Height="18"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding VersionText}"
                                                   FontSize="10.5" Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="4" Margin="0,20,0,0">
                    <TextBlock Text="部分软件会弹出自己的卸载向导或 Windows 权限提示，请按向导完成操作。"
                               TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,14"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" MinWidth="86" Height="36" Padding="16,0"
                                IsCancel="True" Click="CancelButton_OnClick"
                                AutomationProperties.Name="取消卸载"/>
                        <Button x:Name="ConfirmButton" Content="开始卸载" MinWidth="104" Height="36"
                                Padding="16,0" Margin="10,0,0,0"
                                Style="{StaticResource Wam.AccentButtonStyle}"
                                Click="ConfirmButton_OnClick"
                                AutomationProperties.Name="开始卸载所选软件"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
