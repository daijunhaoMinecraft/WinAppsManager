<Window x:Class="WinAppsManager.Dialogs.DeepCleanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:models="clr-namespace:WinAppsManager.Models"
        Title="强制卸载残留"
        Width="780"
        Height="640"
        MinHeight="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_OnLoaded"
        Closing="Window_OnClosing"
        AutomationProperties.Name="强制卸载残留（深度清理）">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="LeftoverTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Padding" Value="2,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Border Background="{DynamicResource Wam.CardBackgroundBrush}"
                BorderBrush="{DynamicResource Wam.CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="24,22,24,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" Opacity="0.28" ShadowDepth="6" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="10"
                            Background="{DynamicResource Wam.AccentSoftBrush}"
                            VerticalAlignment="Top" Margin="0,0,13,0">
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Delete_20_Regular}"
                                     FontSize="20"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource Wam.AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="强制卸载残留"
                                   FontSize="21" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                        <TextBlock Text="注册表项默认勾选；安装目录、用户数据目录、快捷方式和 MSI 记录默认不勾选，勾选后会删除真实文件。"
                                   TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <Border x:Name="AppInfoPanel" Grid.Row="1" Background="{DynamicResource Wam.SubtleBackgroundBrush}"
                        CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0"
                                Background="{DynamicResource Wam.IconPlateBrush}"
                                VerticalAlignment="Center">
                            <Grid>
                                <Border CornerRadius="8" Background="{Binding AvatarBackground}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Initial}" FontSize="13" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <Image Source="{Binding IconSource}" Width="26" Height="26"
                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="AppNameText" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                            <TextBlock x:Name="AppDetailText" FontSize="11" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,14,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SelectAllButton" Content="全选" Height="30" Padding="12,0"
                            Click="SelectAllButton_OnClick"
                            AutomationProperties.Name="全选全部残留项"/>
                    <Button x:Name="SelectNoneButton" Grid.Column="1" Content="全不选"
                            Height="30" Padding="12,0" Margin="8,0,0,0"
                            Click="SelectNoneButton_OnClick"
                            AutomationProperties.Name="取消全部勾选"/>
                    <TextBlock x:Name="SelectionText" Grid.Column="3" FontSize="12"
                               VerticalAlignment="Center"
                               Text="已选择 0 项"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                </Grid>

                <Border x:Name="ConfirmBar" Grid.Row="3" Visibility="Collapsed"
                        Background="{DynamicResource Wam.AccentSoftBrush}"
                        CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ConfirmText" TextWrapping="Wrap" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                   Foreground="{DynamicResource Wam.DangerBrush}"/>
                        <Button Grid.Column="1" Content="确认删除" Height="32" Padding="14,0"
                                Click="ConfirmDeleteButton_OnClick"
                                AutomationProperties.Name="确认删除所选残留"/>
                        <Button Grid.Column="2" Content="返回" Height="32" Padding="12,0"
                                Margin="8,0,0,0" Click="CancelConfirmButton_OnClick"/>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Background="{DynamicResource Wam.SubtleBackgroundBrush}"
                        CornerRadius="8" Padding="8,6">
                    <Grid>
                        <TreeView x:Name="LeftoverTree"
                                  ItemsSource="{Binding Groups}"
                                  ItemContainerStyle="{StaticResource LeftoverTreeItemStyle}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  AutomationProperties.Name="软件残留列表">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type models:LeftoverNode}"
                                                          ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsSelectable}"
                                                  MinWidth="0" VerticalAlignment="Center"
                                                  Margin="0,0,8,0"
                                                  AutomationProperties.Name="{Binding Title}"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="12"
                                                       MaxWidth="520"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DisplayPath}"
                                                       Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="10.5"
                                                       MaxWidth="520"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,1,0,0"
                                                       Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource Wam.AccentSoftBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Badge}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Badge}" FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Wam.AccentBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding CleanupStatusText}" FontSize="10.5"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Wam.TextSecondaryBrush}"
                                                   Visibility="Collapsed">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCleanupStatus}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>

                        <StackPanel x:Name="EmptyPanel" Visibility="Collapsed"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Checkmark_20_Regular}"
                                         FontSize="26"
                                         HorizontalAlignment="Center"
                                         Foreground="{DynamicResource Wam.SuccessBrush}"/>
                            <TextBlock x:Name="EmptyText" Text="没有发现软件残留"
                                       FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                            <TextBlock x:Name="EmptyDescriptionText"
                                       Text="该软件没有留下可识别的注册表项、文件夹或快捷方式残留。"
                                       FontSize="11.5" Margin="0,6,0,0" MaxWidth="420"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel x:Name="BusyPanel" Visibility="Collapsed"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:ProgressRing IsActive="True" IsIndeterminate="True"
                                             Width="28" Height="28"
                                             HorizontalAlignment="Center"
                                             Foreground="{DynamicResource Wam.AccentBrush}"
                                             Background="Transparent"/>
                            <TextBlock x:Name="BusyText" Text="正在扫描注册表…"
                                       FontSize="12" Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="5" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SummaryText" Text="正在读取注册表…"
                               TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    <Button x:Name="RescanButton" Grid.Column="1" Content="重新扫描"
                            Height="36" Padding="14,0" Visibility="Collapsed"
                            Click="RescanButton_OnClick"
                            AutomationProperties.Name="重新扫描软件残留"/>
                    <Button x:Name="DeleteButton" Grid.Column="2" Content="删除选中"
                            Height="36" Padding="14,0" Margin="8,0,0,0"
                            IsEnabled="False" Click="DeleteButton_OnClick"
                            AutomationProperties.Name="删除勾选的软件残留"/>
                    <Button x:Name="CloseButton" Grid.Column="3" Content="关闭"
                            MinWidth="92" Height="36" Padding="16,0" Margin="8,0,0,0"
                            Click="CloseButton_OnClick"
                            AutomationProperties.Name="关闭深度清理窗口"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
