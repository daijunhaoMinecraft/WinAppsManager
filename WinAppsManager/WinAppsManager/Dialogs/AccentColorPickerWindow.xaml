<Window x:Class="WinAppsManager.Dialogs.AccentColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Title="自定义主题色"
        Width="430"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="自定义主题色">
    <Grid Margin="20">
        <Border Background="{DynamicResource Wam.CardBackgroundBrush}"
                BorderBrush="{DynamicResource Wam.CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="24,22,24,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" Opacity="0.28" ShadowDepth="6" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 用彩虹色块代替图标：不依赖字体图标里是否真的有调色盘字形。 -->
                    <Border Width="42" Height="42" CornerRadius="10" VerticalAlignment="Top"
                            Margin="0,0,13,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF4D4D" Offset="0"/>
                                <GradientStop Color="#FFD24D" Offset="0.25"/>
                                <GradientStop Color="#4DD964" Offset="0.5"/>
                                <GradientStop Color="#4D9BFF" Offset="0.75"/>
                                <GradientStop Color="#B44DFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="自定义主题色"
                                   FontSize="21" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                        <TextBlock Text="拖动色相、饱和度与亮度，或直接输入 #RRGGBB。"
                                   FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0">
                    <Border x:Name="PreviewSwatch" Width="58" Height="58" CornerRadius="12"
                            BorderThickness="1" BorderBrush="{DynamicResource Wam.CardBorderBrush}"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="十六进制" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                        <TextBox x:Name="HexBox" Width="132" Height="32" Margin="0,5,0,0"
                                 Padding="8,0" FontSize="12.5" VerticalContentAlignment="Center"
                                 TextChanged="HexBox_OnTextChanged"
                                 AutomationProperties.Name="主题色十六进制值"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,18,0,0">
                    <Grid>
                        <TextBlock Text="色相" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                        <TextBlock x:Name="HueText" HorizontalAlignment="Right" FontSize="12"
                                   Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    </Grid>
                    <Slider x:Name="HueSlider" Minimum="0" Maximum="360" Margin="0,6,0,0"
                            VerticalAlignment="Center" ValueChanged="OnSliderChanged"
                            AutomationProperties.Name="色相">
                        <Slider.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FF4D4D" Offset="0"/>
                                <GradientStop Color="#FFD24D" Offset="0.17"/>
                                <GradientStop Color="#4DD964" Offset="0.33"/>
                                <GradientStop Color="#4DD9D9" Offset="0.5"/>
                                <GradientStop Color="#4D9BFF" Offset="0.67"/>
                                <GradientStop Color="#B44DFF" Offset="0.83"/>
                                <GradientStop Color="#FF4D4D" Offset="1"/>
                            </LinearGradientBrush>
                        </Slider.Background>
                    </Slider>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                    <Grid>
                        <TextBlock Text="饱和度" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                        <TextBlock x:Name="SaturationText" HorizontalAlignment="Right" FontSize="12"
                                   Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    </Grid>
                    <Slider x:Name="SaturationSlider" Minimum="0" Maximum="100" Margin="0,6,0,0"
                            VerticalAlignment="Center" ValueChanged="OnSliderChanged"
                            AutomationProperties.Name="饱和度"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,12,0,0">
                    <Grid>
                        <TextBlock Text="亮度" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                        <TextBlock x:Name="ValueText" HorizontalAlignment="Right" FontSize="12"
                                   Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    </Grid>
                    <Slider x:Name="ValueSlider" Minimum="5" Maximum="100" Margin="0,6,0,0"
                            VerticalAlignment="Center" ValueChanged="OnSliderChanged"
                            AutomationProperties.Name="亮度"/>
                </StackPanel>

                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,20,0,0">
                    <Button Content="取消" MinWidth="86" Height="36" Padding="16,0"
                            IsCancel="True" Click="CancelButton_OnClick"
                            AutomationProperties.Name="取消自定义主题色"/>
                    <Button x:Name="ConfirmButton" Content="使用这个颜色" MinWidth="120" Height="36"
                            Padding="16,0" Margin="10,0,0,0"
                            Style="{StaticResource Wam.AccentButtonStyle}"
                            Click="ConfirmButton_OnClick"
                            AutomationProperties.Name="应用自定义主题色"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
