<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows 7 SP1 兼容自包含发布配置（x86 / 32 位，SelfContained=true）。
  .NET 6 是最后一个官方支持 Windows 7 SP1 的 .NET 版本，因此这里固定 net6.0-windows7.0。
  用法：Rider/Visual Studio 的“发布”中选择本配置，或执行：
    dotnet publish WinAppsManager\WinAppsManager\WinAppsManager.csproj -c Release -f net6.0-windows7.0 -r win-x86 -p:PublishProfile=Win7-x86-selfcontained
  与 Win7-x86.pubxml 的区别：本配置把 .NET 6 Desktop Runtime（x86）一起打包进输出目录，
  目标机器无需预装 .NET 6 Desktop Runtime（Windows 7 仍需 SP1 及必要系统更新）。
  代价是发布体积明显更大；目标机器已安装 .NET 6 Desktop Runtime（x86）时优先使用框架依赖的 Win7-x86.pubxml。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\publish\win7-x86-selfcontained\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net6.0-windows7.0</TargetFramework>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
