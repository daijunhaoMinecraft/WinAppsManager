<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows 7 SP1 兼容发布配置（x64）。
  .NET 6 是最后一个官方支持 Windows 7 SP1 的 .NET 版本，因此这里固定 net6.0-windows7.0。
  用法：Rider/Visual Studio 的“发布”中选择本配置，或执行：
    dotnet publish WinAppsManager\WinAppsManager\WinAppsManager.csproj -c Release -f net6.0-windows7.0 -r win-x64 -p:PublishProfile=Win7-x64
  本配置为框架依赖发布（SelfContained=false）；目标机器需安装 .NET 6 Desktop Runtime，Windows 7 需 SP1 及必要系统更新。
  如果目标机器无法预装 .NET 6 Desktop Runtime，改用同目录的 Win7-x64-selfcontained.pubxml（体积更大）。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\publish\win7-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net6.0-windows7.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
