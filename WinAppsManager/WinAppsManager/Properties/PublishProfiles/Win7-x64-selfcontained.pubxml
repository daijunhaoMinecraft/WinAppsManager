<?xml version="1.0" encoding="utf-8"?>
<!--
  单一构建自包含发布配置（x64，SelfContained=true）：同一套 net6 构建支持 Windows 7–11，
  不再为 Windows 10+ 单独打包。商店应用（MSIX / Microsoft Store）在 Windows 10+ 自动可用
  （运行时调用 Windows PowerShell 的 Get-AppxPackage 枚举），Windows 7 / 8 / 8.1 上自动不显示商店应用并提示不支持。
  .NET 6 是最后一个官方支持 Windows 7 SP1 的 .NET 版本，因此这里固定 net6.0-windows7.0。
  用法：Rider/Visual Studio 的“发布”中选择本配置，或执行：
    dotnet publish WinAppsManager\WinAppsManager\WinAppsManager.csproj -c Release -f net6.0-windows7.0 -r win-x64 -p:PublishProfile=Win7-x64-selfcontained
  与 Win7-x64.pubxml 的区别：本配置把 .NET 6 Desktop Runtime 一起打包进输出目录，
  目标机器无需预装 .NET 6 Desktop Runtime（Windows 7 仍需 SP1 及必要系统更新）。
  代价是发布体积明显更大；目标机器已安装 .NET 6 Desktop Runtime 时优先使用框架依赖的 Win7-x64.pubxml。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\publish\win7-x64-selfcontained\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net6.0-windows7.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
