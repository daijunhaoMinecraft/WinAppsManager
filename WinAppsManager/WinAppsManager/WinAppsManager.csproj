<Project Sdk="Microsoft.NET.Sdk">

    <!-- 版本号来自仓库根目录的 release.props，发布 workflow 也读取同一份文件。 -->
    <Import Project="..\..\release.props" />

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!--
          单一构建：net6.0-windows7.0 同时支持 Windows 7 SP1 / 8 / 8.1 / 10 / 11，不再为 Windows 10+ 单独打包。
          .NET 6 是最后一个官方支持 Windows 7 SP1 的 .NET 版本，因此固定该目标。
          商店应用（MSIX / Microsoft Store）不再依赖 WinRT：运行时由 StoreApplicationProvider 调用
          Windows PowerShell 的 Get-AppxPackage 枚举，Windows 10 / 11 自动可用；
          Windows 7 / 8 / 8.1 上 IsSupported 返回 false，界面给出“当前系统不支持”的提示。
        -->
        <TargetFramework>net6.0-windows7.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <CheckEolTargetFramework>false</CheckEolTargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <!-- 32 位（x86）Windows 用户可通过 dotnet publish -r win-x86 获得对应构建。 -->
        <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
        <SelfContained>false</SelfContained>
        <AssemblyName>WinAppsManager</AssemblyName>
        <RootNamespace>WinAppsManager</RootNamespace>
        <!-- 启动即请求管理员权限：强制卸载需要结束占用进程、删除 HKLM/Program Files 残留。 -->
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="iNKORE.UI.WPF" Version="1.2.8" />
      <PackageReference Include="iNKORE.UI.WPF.Modern" Version="0.11.0" />
      <PackageReference Include="PixiEditor.ColorPicker" Version="3.4.2.3" />
    </ItemGroup>

    <ItemGroup>
      <!--
        Windows 7 默认没有 Segoe Fluent Icons / Segoe MDL2 Assets 字体，图标会显示为方框。
        随程序嵌入开源 MIT 许可的 Fluent System Icons，并在 App.xaml 中作为图标字体使用。
      -->
      <Resource Include="Assets\Fonts\FluentSystemIcons-Regular.ttf" />
    </ItemGroup>

</Project>
