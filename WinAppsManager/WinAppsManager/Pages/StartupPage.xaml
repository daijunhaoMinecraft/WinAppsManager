<ui:Page x:Class="WinAppsManager.Pages.StartupPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:models="clr-namespace:WinAppsManager.Models"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         mc:Ignorable="d"
         d:DesignWidth="800" d:DesignHeight="650"
         Background="{DynamicResource Wam.PageBackgroundBrush}"
         Title="自启动项"
         Loaded="OnPageLoaded" Unloaded="OnPageUnloaded">
    <ui:Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- 让行模板里的 ColumnDefinition 能绑定到页面的列宽对象：
             ColumnDefinition 不在可视化树里，用不了 RelativeSource。 -->
        <models:BindingProxy x:Key="LayoutProxy" Data="{Binding}"/>

        <!-- 与卸载页同一份虚拟化模板：iNKORE 默认 ListBox 模板用 CanContentScroll=false 滚动，
             会静默关掉 VirtualizingStackPanel，几百行时一次排序就是秒级卡顿。 -->
        <Style x:Key="VirtualizedRowListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False"
                                      CanContentScroll="True"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="{TemplateBinding Padding}">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReportHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Wam.TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Wam.AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 列宽拖动条：贴在每列右边缘的 6px 热区。 -->
        <Style x:Key="ColumnThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Panel.ZIndex" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Wam.AccentSoftBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StartupRowStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="6,5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                    <Setter Property="Background" Value="#18F85149"/>
                    <Setter Property="ToolTip" Value="找不到对应的目标文件，此自启动项已失效"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Wam.SubtleBackgroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="StartupListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="StartupRowTemplate">
            <Border Style="{StaticResource StartupRowStyle}"
                    ContextMenuOpening="StartupRow_ContextMenuOpening"
                    Loaded="StartupRow_OnLoaded">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="启动时禁止运行"
                                  Tag="toggle" Click="ContextToggle_OnClick"/>
                        <MenuItem Header="从列表中删除" Tag="delete" Click="ContextDelete_OnClick"/>
                        <Separator/>
                        <MenuItem Header="浏览程序位置…" Tag="location" Click="ContextOpenLocation_OnClick"/>
                        <MenuItem Header="浏览来源…" Click="ContextOpenSource_OnClick"/>
                        <MenuItem Header="在 Microsoft Store 中查看" Tag="store" Visibility="Collapsed"
                                  Click="ContextOpenStore_OnClick"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding Data.Columns[0], Source={StaticResource LayoutProxy}}"/>
                        <ColumnDefinition Width="{Binding Data.Columns[1], Source={StaticResource LayoutProxy}}"/>
                        <ColumnDefinition Width="{Binding Data.Columns[2], Source={StaticResource LayoutProxy}}"/>
                        <ColumnDefinition Width="*" MinWidth="0"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="24" Height="24" CornerRadius="6" Margin="0,0,9,0" VerticalAlignment="Center"
                                Background="{DynamicResource Wam.IconPlateBrush}">
                            <Grid>
                                <Border CornerRadius="6" Background="{Binding AvatarBackground}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <Image Source="{Binding IconSource}" Width="24" Height="24"
                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" ToolTip="{Binding NameToolTip}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Wam.TextPrimaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <TextBlock Grid.Column="1" Text="{Binding SourceText}" FontSize="11" Margin="0,0,10,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>

                    <TextBlock Grid.Column="2" Text="{Binding CompanyName}" FontSize="11" Margin="0,0,10,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>

                    <TextBlock Grid.Column="3" Text="{Binding CommandText}" FontSize="11" Margin="0,0,10,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Wam.TextSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    
                    <TextBlock Grid.Column="4" Text="{Binding RuntimeStatusText}" FontSize="11.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Wam.TextSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <CheckBox Grid.Column="5" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                              Focusable="False" VerticalAlignment="Center" HorizontalAlignment="Center"
                              MinWidth="0" Padding="0" Margin="0"
                              Click="EnabledCheckBox_OnClick"
                              AutomationProperties.Name="{Binding Name, StringFormat=启用 {0}}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </ui:Page.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="PageTitleText" Text="自启动项" FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                <TextBlock x:Name="CountText" FontSize="12" Margin="0,2,0,0"
                           Text="正在读取本机的自启动项…"
                           Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
            </StackPanel>
            <ComboBox x:Name="SortCombo" Grid.Column="1" Width="112" Height="36"
                      Padding="10,0" VerticalAlignment="Center" Margin="0,0,8,0"
                      SelectionChanged="SortCombo_OnSelectionChanged"
                      AutomationProperties.Name="排序字段">
                <ComboBoxItem Content="名称" Tag="Name"/>
                <ComboBoxItem Content="来源" Tag="Source"/>
                <ComboBoxItem Content="公司" Tag="Company"/>
                <ComboBoxItem Content="状态" Tag="Status"/>
            </ComboBox>
            <Button x:Name="SortDirectionButton" Grid.Column="2" Content="↑" Width="38" Height="36"
                    Padding="0" VerticalAlignment="Center" Margin="0,0,8,0"
                    FontSize="14" Click="SortDirection_OnClick"
                    ToolTip="切换升序 / 降序"
                    AutomationProperties.Name="切换排序方向"/>
            <Button x:Name="RefreshButton" Grid.Column="3" Content="刷新列表" Height="36"
                    Padding="14,0" VerticalAlignment="Center" Margin="0,0,8,0"
                    Click="RefreshButton_OnClick"
                    AutomationProperties.Name="刷新自启动项列表"/>
            <Button x:Name="AddButton" Grid.Column="4" Content="添加自启动项" Height="36"
                    Padding="14,0" VerticalAlignment="Center" Click="AddButton_OnClick"
                    AutomationProperties.Name="添加自启动项"/>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource Wam.CardBackgroundBrush}"
                BorderBrush="{DynamicResource Wam.CardBorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="12,9" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid VerticalAlignment="Center" MaxWidth="430" HorizontalAlignment="Left">
                    <TextBox x:Name="SearchBox" Height="34" Padding="10,0" FontSize="12.5"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_OnTextChanged"
                             AutomationProperties.Name="搜索自启动项"
                             ToolTip="按名称、公司、来源、命令行或登记位置搜索"/>
                    <TextBlock Text="搜索名称、公司或命令行" Margin="11,0,11,0"
                               VerticalAlignment="Center" IsHitTestVisible="False" FontSize="12.5"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <ComboBox x:Name="SourceFilterCombo" Grid.Column="1" Width="140" Height="34"
                          Padding="10,0" Margin="16,0,0,0" VerticalAlignment="Center"
                          SelectionChanged="SourceFilterCombo_OnSelectionChanged"
                          AutomationProperties.Name="按来源筛选"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2">
            <Border x:Name="LoadingPanel" Visibility="Collapsed" Margin="0,0,0,8" Padding="12,8"
                    Background="{DynamicResource Wam.CardBackgroundBrush}" CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing IsActive="True" IsIndeterminate="True" Width="24" Height="24"
                                     Foreground="{DynamicResource Wam.AccentBrush}"
                                     Background="Transparent" VerticalAlignment="Center"/>
                    <TextBlock Text="正在读取 Run 注册表、启动文件夹、计划任务和应用启动任务…" Margin="10,0,0,0"
                               VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
            <Border x:Name="ErrorPanel" Visibility="Collapsed" Margin="0,0,0,8" Padding="12,9"
                    Background="{DynamicResource Wam.CardBackgroundBrush}" CornerRadius="8"
                    BorderBrush="{DynamicResource Wam.CardBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="无法读取自启动项" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                        <TextBlock x:Name="ErrorText" Margin="0,3,0,0" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="重试" Padding="12,5" VerticalAlignment="Center"
                            Click="RefreshButton_OnClick"/>
                </Grid>
            </Border>
            <!-- 操作结果：InfoBar 按 Severity 区分信息 / 成功 / 警告 / 失败，可手动关闭。 -->
            <ui:InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True"
                        Severity="Informational" Margin="0,0,0,8"
                        AutomationProperties.Name="操作状态"/>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="ReportHeader" Margin="6,0,6,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Data.Columns[0], Source={StaticResource LayoutProxy}}"/>
                    <ColumnDefinition Width="{Binding Data.Columns[1], Source={StaticResource LayoutProxy}}"/>
                    <ColumnDefinition Width="{Binding Data.Columns[2], Source={StaticResource LayoutProxy}}"/>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="16"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="HeaderName" Grid.Column="0" Content="名称" Tag="Name"
                        Style="{StaticResource ReportHeaderButtonStyle}" Click="ReportHeader_OnClick"/>
                <Button x:Name="HeaderSource" Grid.Column="1" Content="来源" Tag="Source"
                        Style="{StaticResource ReportHeaderButtonStyle}" Click="ReportHeader_OnClick"/>
                <Button x:Name="HeaderCompany" Grid.Column="2" Content="公司" Tag="Company"
                        Style="{StaticResource ReportHeaderButtonStyle}" Click="ReportHeader_OnClick"/>
                <TextBlock Grid.Column="3" Text="命令行" FontSize="11" Margin="4,3,0,3"
                           Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                <TextBlock Grid.Column="4" Text="状态" FontSize="11" Margin="0,3,0,3"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                <TextBlock Grid.Column="5" Text="启用" FontSize="11" Margin="0,3,0,3"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                <Thumb Grid.Column="0" Style="{StaticResource ColumnThumbStyle}"
                       DragDelta="NameColumn_OnDragDelta" ToolTip="拖动调整“名称”列宽"/>
                <Thumb Grid.Column="1" Style="{StaticResource ColumnThumbStyle}"
                       DragDelta="SourceColumn_OnDragDelta" ToolTip="拖动调整“来源”列宽"/>
                <Thumb Grid.Column="2" Style="{StaticResource ColumnThumbStyle}"
                       DragDelta="CompanyColumn_OnDragDelta" ToolTip="拖动调整“公司”列宽"/>
                <Border Grid.Column="0" Grid.ColumnSpan="7" Height="1" VerticalAlignment="Bottom"
                        Background="{DynamicResource Wam.CardBorderBrush}" Margin="0,0,0,-2"/>
            </Grid>
            
            <ListBox x:Name="ItemsList" Grid.Row="1" ItemsSource="{Binding StartupItems}"
                     ItemTemplate="{StaticResource StartupRowTemplate}"
                     Style="{StaticResource VirtualizedRowListStyle}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ItemContainerStyle="{StaticResource StartupListItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Item"
                     ScrollViewer.CanContentScroll="True"
                     AutomationProperties.Name="自启动项列表">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <Border x:Name="EmptyState" Grid.Row="1" Visibility="Collapsed" CornerRadius="10"
                    Background="{DynamicResource Wam.CardBackgroundBrush}"
                    BorderBrush="{DynamicResource Wam.CardBorderBrush}" BorderThickness="1"
                    VerticalAlignment="Top" Padding="28,36">
                <StackPanel HorizontalAlignment="Center">
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Rocket_20_Regular}" FontSize="28"
                                 HorizontalAlignment="Center"
                                 Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    <TextBlock x:Name="EmptyTitleText" Text="没有找到自启动项"
                               FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                    <TextBlock x:Name="EmptyDescriptionText"
                               Text="这里显示 Run/RunOnce 注册表项、启动文件夹快捷方式、登录时运行的计划任务和应用启动任务。"
                               FontSize="12" Margin="0,7,0,16" MaxWidth="430"
                               TextAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    <Button Content="刷新列表" Padding="16,8" HorizontalAlignment="Center"
                            Click="RefreshButton_OnClick"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:Page>

