<ui:Page x:Class="WinAppsManager.Pages.UninstallPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         mc:Ignorable="d"
         d:DesignWidth="800" d:DesignHeight="650"
         Background="{DynamicResource Wam.PageBackgroundBrush}"
         Title="卸载软件"
         Loaded="OnPageLoaded" Unloaded="OnPageUnloaded">
    <ui:Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="InstalledCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Wam.CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Wam.CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="13,11"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Wam.AccentBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Wam.AccentBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource Wam.AccentSoftBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The iNKORE ListBox template scrolls with CanContentScroll=false, which silently
             disables VirtualizingStackPanel: every row got realised and one sort cost ~1 s. -->
        <Style x:Key="VirtualizedRowListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False"
                                      CanContentScroll="True"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="{TemplateBinding Padding}">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReportHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Wam.TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Wam.AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InstalledListRowStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="6,5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Wam.SubtleBackgroundBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Wam.AccentSoftBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InstalledListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ReportItemTemplate">
            <Border Style="{StaticResource InstalledListRowStyle}"
                    Cursor="Hand"
                    MouseLeftButtonUp="ApplicationRow_OnMouseLeftButtonUp"
                    Loaded="ApplicationRow_OnLoaded">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="卸载此软件" Click="ContextUninstall_OnClick"/>
                        <MenuItem Header="打开安装位置" Click="ContextOpenLocation_OnClick"/>
                        <MenuItem Header="深度清理残留…" Click="ContextDeepClean_OnClick"/>
                        <Separator/>
                        <MenuItem Header="打开官网" Click="ContextOpenWebsite_OnClick"/>
                        <MenuItem Header="复制软件名称" Click="ContextCopyName_OnClick"/>
                        <MenuItem Header="复制卸载命令" Click="ContextCopyCommand_OnClick"/>
                        <Separator/>
                        <MenuItem Header="刷新列表" Click="ContextRefresh_OnClick"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*" MinWidth="0"/>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="24" Height="24" CornerRadius="6" Margin="2,0,0,0" VerticalAlignment="Center">
                        <Grid>
                            <Border CornerRadius="6" Background="{Binding AvatarBackground}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <Image Source="{Binding IconSource}" Width="24" Height="24"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" ToolTip="{Binding Name}"
                               Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Publisher}" FontSize="11"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="3" Text="{Binding Version}" FontSize="11"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="4" Text="{Binding SizeText}" FontSize="11"
                               TextAlignment="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="5" Text="{Binding ShortInstallDateText}" FontSize="11"
                               TextAlignment="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="6" Text="{Binding InstallLocation}" FontSize="11"
                               Margin="12,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="7" Text="官网" FontSize="10.5" Cursor="Hand"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Wam.AccentBrush}"
                               Visibility="{Binding HasUrl, Converter={StaticResource BoolToVisibility}}"
                               MouseLeftButtonUp="WebsiteText_OnMouseLeftButtonUp"
                               AutomationProperties.Name="{Binding Name, StringFormat=打开 {0} 的官方网站}"/>
                    <CheckBox Grid.Column="8" IsChecked="{Binding IsSelected, Mode=TwoWay}" Focusable="False"
                              VerticalAlignment="Center" HorizontalAlignment="Right"
                              MinWidth="0" Margin="0,0,4,0"
                              Checked="SelectionCheckBox_OnChanged"
                              Unchecked="SelectionCheckBox_OnChanged"
                              AutomationProperties.Name="{Binding Name, StringFormat=选择 {0}}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ListItemTemplate">
            <Border Style="{StaticResource InstalledListRowStyle}"
                    Cursor="Hand"
                    MouseLeftButtonUp="ApplicationRow_OnMouseLeftButtonUp"
                    Loaded="ApplicationRow_OnLoaded">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="卸载此软件" Click="ContextUninstall_OnClick"/>
                        <MenuItem Header="打开安装位置" Click="ContextOpenLocation_OnClick"/>
                        <MenuItem Header="深度清理残留…" Click="ContextDeepClean_OnClick"/>
                        <Separator/>
                        <MenuItem Header="打开官网" Click="ContextOpenWebsite_OnClick"/>
                        <MenuItem Header="复制软件名称" Click="ContextCopyName_OnClick"/>
                        <MenuItem Header="复制卸载命令" Click="ContextCopyCommand_OnClick"/>
                        <Separator/>
                        <MenuItem Header="刷新列表" Click="ContextRefresh_OnClick"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="24" Height="24" CornerRadius="6" Margin="2,0,10,0" VerticalAlignment="Center">
                        <Grid>
                            <Border CornerRadius="6" Background="{Binding AvatarBackground}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <Image Source="{Binding IconSource}" Width="24" Height="24"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" ToolTip="{Binding Name}"
                               Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>

                    <Border Grid.Column="3" BorderBrush="{DynamicResource Wam.CardBorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="6,0" Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasVersion, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding VersionText}" FontSize="10"
                                   Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    </Border>

                    <TextBlock Grid.Column="4" Text="{Binding Publisher}" FontSize="11"
                               Margin="14,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="5" Text="{Binding SizeText}" FontSize="11"
                               Width="86" TextAlignment="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="6" Text="{Binding ShortInstallDateText}" FontSize="11"
                               Width="88" Margin="14,0,0,0" TextAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="7" Text="官网" FontSize="10.5" Cursor="Hand"
                               Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Wam.AccentBrush}"
                               Visibility="{Binding HasUrl, Converter={StaticResource BoolToVisibility}}"
                               MouseLeftButtonUp="WebsiteText_OnMouseLeftButtonUp"
                               AutomationProperties.Name="{Binding Name, StringFormat=打开 {0} 的官方网站}"/>
                    <CheckBox Grid.Column="8" IsChecked="{Binding IsSelected, Mode=TwoWay}" Focusable="False"
                              VerticalAlignment="Center" HorizontalAlignment="Right"
                              MinWidth="0" Margin="14,0,0,0"
                              Checked="SelectionCheckBox_OnChanged"
                              Unchecked="SelectionCheckBox_OnChanged"
                              AutomationProperties.Name="{Binding Name, StringFormat=选择 {0}}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CardItemTemplate">
                        <Border Style="{StaticResource InstalledCardStyle}"
                                Cursor="Hand"
                                MouseLeftButtonUp="ApplicationRow_OnMouseLeftButtonUp"
                                Loaded="ApplicationRow_OnLoaded"
                                ToolTip="{Binding Name}">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="卸载此软件" Click="ContextUninstall_OnClick"/>
                                    <MenuItem Header="打开安装位置" Click="ContextOpenLocation_OnClick"/>
                                    <MenuItem Header="深度清理残留…" Click="ContextDeepClean_OnClick"/>
                                    <Separator/>
                                    <MenuItem Header="打开官网" Click="ContextOpenWebsite_OnClick"/>
                                    <MenuItem Header="复制软件名称" Click="ContextCopyName_OnClick"/>
                                    <MenuItem Header="复制卸载命令" Click="ContextCopyCommand_OnClick"/>
                                    <Separator/>
                                    <MenuItem Header="刷新列表" Click="ContextRefresh_OnClick"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="42" Height="42" CornerRadius="10"
                                        VerticalAlignment="Center" Margin="0,0,13,0">
                                    <Grid>
                                        <Border CornerRadius="10" Background="{Binding AvatarBackground}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <Image Source="{Binding IconSource}" Width="36" Height="36"
                                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                                        <Border Grid.Column="1" BorderBrush="{DynamicResource Wam.CardBorderBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="6,1"
                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding HasVersion, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding VersionText}" FontSize="10"
                                                       Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                                        </Border>
                                        <Border Grid.Column="2" CornerRadius="4" Padding="6,1"
                                                Margin="6,0,0,0" VerticalAlignment="Center"
                                                Background="{DynamicResource Wam.AccentSoftBrush}"
                                                Visibility="{Binding HasCategoryBadge, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding CategoryBadge}" FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Wam.AccentBrush}"/>
                                        </Border>
                                        <Button Grid.Column="3" Content="官网" Height="22" Padding="7,0"
                                                Margin="6,0,0,0" VerticalAlignment="Center"
                                                FontSize="10.5" Cursor="Hand"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{DynamicResource Wam.AccentBrush}"
                                                ToolTip="{Binding UrlInfoAbout}"
                                                Visibility="{Binding HasUrl, Converter={StaticResource BoolToVisibility}}"
                                                Click="OpenWebsite_OnClick"
                                                AutomationProperties.Name="{Binding Name, StringFormat=打开 {0} 的官方网站}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding SummaryText}" FontSize="11.5"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               Margin="0,3,0,0"
                                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DetailsText}" FontSize="10.5"
                                                   Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text=" · " FontSize="10.5"
                                                   Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding LocationText}" FontSize="10.5"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                                    </Grid>
                                </StackPanel>

                                <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          VerticalAlignment="Center" HorizontalAlignment="Right"
                                          MinWidth="0" Margin="12,0,0,0"
                                          Checked="SelectionCheckBox_OnChanged"
                                          Unchecked="SelectionCheckBox_OnChanged"
                                          AutomationProperties.Name="{Binding Name, StringFormat=选择 {0}}"/>
                            </Grid>
                        </Border>
        </DataTemplate>

    </ui:Page.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="PageTitleText" Text="已安装软件" FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                <TextBlock x:Name="CountText" FontSize="12" Margin="0,2,0,0"
                           Text="正在读取本机的卸载信息…"
                           Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
            </StackPanel>
            <ComboBox x:Name="DisplayModeCombo" Grid.Column="1" Width="112" Height="36"
                      Padding="10,0" VerticalAlignment="Center" Margin="0,0,8,0"
                      SelectionChanged="DisplayMode_OnSelectionChanged"
                      AutomationProperties.Name="列表显示方式">
                <ComboBoxItem Content="报表式" Tag="Report"/>
                <ComboBoxItem Content="列表式" Tag="List"/>
                <ComboBoxItem Content="卡片式" Tag="Card"/>
            </ComboBox>
            <ComboBox x:Name="SortCombo" Grid.Column="2" Width="112" Height="36"
                      Padding="10,0" VerticalAlignment="Center" Margin="0,0,8,0"
                      SelectionChanged="SortCombo_OnSelectionChanged"
                      AutomationProperties.Name="排序字段">
                <ComboBoxItem Content="名称" Tag="Name"/>
                <ComboBoxItem Content="发布者" Tag="Publisher"/>
                <ComboBoxItem Content="大小" Tag="Size"/>
                <ComboBoxItem Content="安装日期" Tag="Date"/>
            </ComboBox>
            <Button x:Name="SortDirectionButton" Grid.Column="3" Content="↑" Width="38" Height="36"
                    Padding="0" VerticalAlignment="Center" Margin="0,0,8,0"
                    FontSize="14" Click="SortDirection_OnClick"
                    ToolTip="切换升序 / 降序"
                    AutomationProperties.Name="切换排序方向"/>
            <Button x:Name="RefreshButton" Grid.Column="4" Content="刷新列表" Height="36"
                    Padding="14,0" VerticalAlignment="Center" Click="RefreshButton_OnClick"
                    AutomationProperties.Name="刷新已安装软件列表"/>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource Wam.CardBackgroundBrush}"
                BorderBrush="{DynamicResource Wam.CardBorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="12,9" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid VerticalAlignment="Center" MaxWidth="430" HorizontalAlignment="Left">
                    <TextBox x:Name="SearchBox" Height="34" Padding="10,0" FontSize="12.5"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_OnTextChanged"
                             AutomationProperties.Name="搜索已安装软件"
                             ToolTip="按软件名称、发布者、版本、安装位置或来源搜索"/>
                    <TextBlock Text="搜索名称、发布者或来源" Margin="11,0,11,0"
                               VerticalAlignment="Center" IsHitTestVisible="False" FontSize="12.5"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <CheckBox x:Name="SelectAllCheckBox" Grid.Column="1" Content="全选当前列表"
                          Margin="16,0,0,0" VerticalAlignment="Center"
                          Checked="SelectAllCheckBox_OnChanged"
                          Unchecked="SelectAllCheckBox_OnChanged"
                          AutomationProperties.Name="全选当前列表"/>

                <TextBlock x:Name="SelectedCountText" Grid.Column="2" Margin="16,0,0,0"
                           Text="已选择 0 个" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>

                <Button x:Name="ClearSelectionButton" Grid.Column="3" Content="清除选择"
                        Height="34" Padding="11,0" Margin="10,0,0,0"
                        Visibility="Collapsed" Click="ClearSelectionButton_OnClick"
                        AutomationProperties.Name="清除全部选择"/>

                <Button x:Name="DeepCleanButton" Grid.Column="4" Content="深度清理"
                        Height="34" Padding="12,0" Margin="10,0,0,0"
                        IsEnabled="False" Click="DeepCleanButton_OnClick"
                        ToolTip="扫描该软件在注册表中的残留，按需勾选删除"
                        AutomationProperties.Name="深度清理所选软件的注册表残留"/>

                <Button x:Name="UninstallButton" Grid.Column="5" Content="卸载所选"
                        Height="34" Padding="14,0" Margin="10,0,0,0"
                        IsEnabled="False" Click="UninstallButton_OnClick"
                        AutomationProperties.Name="卸载所选软件"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2">
            <Border x:Name="LoadingPanel" Visibility="Collapsed" Margin="0,0,0,8" Padding="12,8"
                    Background="{DynamicResource Wam.CardBackgroundBrush}" CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing IsActive="True" IsIndeterminate="True" Width="24" Height="24"
                                     Foreground="{DynamicResource Wam.AccentBrush}"
                                     Background="Transparent" VerticalAlignment="Center"/>
                    <TextBlock Text="正在读取 Windows 卸载注册表和商店应用…" Margin="10,0,0,0"
                               VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
            <Border x:Name="ErrorPanel" Visibility="Collapsed" Margin="0,0,0,8" Padding="12,9"
                    Background="{DynamicResource Wam.CardBackgroundBrush}" CornerRadius="8"
                    BorderBrush="{DynamicResource Wam.CardBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="无法读取已安装软件" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                        <TextBlock x:Name="ErrorText" Margin="0,3,0,0" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="重试" Padding="12,5" VerticalAlignment="Center"
                            Click="RefreshButton_OnClick"/>
                </Grid>
            </Border>
            <Border x:Name="StatusPanel" Visibility="Collapsed" Margin="0,0,0,8" Padding="12,9"
                    Background="{DynamicResource Wam.AccentSoftBrush}" CornerRadius="8">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="ReportHeader" Margin="6,0,6,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="HeaderName" Grid.Column="1" Content="名称" Tag="Name"
                        Style="{StaticResource ReportHeaderButtonStyle}" Click="ReportHeader_OnClick"/>
                <Button x:Name="HeaderPublisher" Grid.Column="2" Content="发布者" Tag="Publisher"
                        Style="{StaticResource ReportHeaderButtonStyle}" Click="ReportHeader_OnClick"/>
                <Button x:Name="HeaderVersion" Grid.Column="3" Content="版本"
                        Style="{StaticResource ReportHeaderButtonStyle}"/>
                <Button x:Name="HeaderSize" Grid.Column="4" Content="大小" Tag="Size"
                        Style="{StaticResource ReportHeaderButtonStyle}"
                        HorizontalContentAlignment="Right" Click="ReportHeader_OnClick"/>
                <Button x:Name="HeaderDate" Grid.Column="5" Content="安装日期" Tag="Date"
                        Style="{StaticResource ReportHeaderButtonStyle}"
                        HorizontalContentAlignment="Right" Click="ReportHeader_OnClick"/>
                <Button x:Name="HeaderLocation" Grid.Column="6" Content="安装位置"
                        Style="{StaticResource ReportHeaderButtonStyle}" Padding="16,3,4,3"/>
                <Border Grid.Column="0" Grid.ColumnSpan="9" Height="1" VerticalAlignment="Bottom"
                        Background="{DynamicResource Wam.CardBorderBrush}" Margin="0,0,0,-2"/>
            </Grid>

            <ListBox x:Name="AppsList" Grid.Row="1" ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource ListItemTemplate}"
                     Style="{StaticResource VirtualizedRowListStyle}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ItemContainerStyle="{StaticResource InstalledListItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Item"
                     ScrollViewer.CanContentScroll="True"
                     AutomationProperties.Name="已安装软件列表">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <Border x:Name="EmptyState" Grid.Row="1" Visibility="Collapsed" CornerRadius="10"
                    Background="{DynamicResource Wam.CardBackgroundBrush}"
                    BorderBrush="{DynamicResource Wam.CardBorderBrush}" BorderThickness="1"
                    VerticalAlignment="Top" Padding="28,36">
                <StackPanel HorizontalAlignment="Center">
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Delete}" FontSize="28"
                                 HorizontalAlignment="Center"
                                 Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    <TextBlock x:Name="EmptyTitleText" Text="没有找到可卸载的软件"
                               FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource Wam.TextPrimaryBrush}"/>
                    <TextBlock x:Name="EmptyDescriptionText"
                               Text="这里显示 Windows 卸载注册表和当前用户商店应用中可以卸载的软件。"
                               FontSize="12" Margin="0,7,0,16" MaxWidth="430"
                               TextAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    <Button Content="刷新列表" Padding="16,8" HorizontalAlignment="Center"
                            Click="RefreshButton_OnClick"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:Page>
