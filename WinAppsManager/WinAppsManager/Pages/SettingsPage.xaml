<ui:Page x:Class="WinAppsManager.Pages.SettingsPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         Background="{DynamicResource Wam.PageBackgroundBrush}"
         Foreground="{DynamicResource Wam.TextPrimaryBrush}"
         Title="设置"
         Loaded="OnPageLoaded"
         Unloaded="OnPageUnloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,26,28,32" MaxWidth="960" HorizontalAlignment="Stretch">
            <TextBlock Text="设置" Style="{StaticResource Wam.PageTitleTextBlockStyle}"/>
            <TextBlock Text="让软件管理更符合你的使用习惯。"
                       Style="{StaticResource Wam.SecondaryTextBlockStyle}" Margin="0,8,0,24"/>

            <Border x:Name="SettingsErrorPanel" Style="{StaticResource Wam.CardBorderStyle}"
                    Background="{DynamicResource Wam.AccentSoftBrush}" Visibility="Collapsed" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="设置提示" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="SettingsErrorText" TextWrapping="Wrap"/>
                    <Button Content="重新保存设置" Click="OnRetrySaveSettings" HorizontalAlignment="Left"
                            Padding="15,7" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Wam.CardBorderStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="外观" Style="{StaticResource Wam.SectionTitleTextBlockStyle}"/>
                    <TextBlock Text="选择应用主题，更改会立即生效并自动保存。"
                               Style="{StaticResource Wam.SecondaryTextBlockStyle}" Margin="0,7,0,20"/>
                    <UniformGrid Columns="3">
                        <RadioButton x:Name="SystemThemeOption" Tag="System" GroupName="AppTheme"
                                     Checked="OnThemeChecked" VerticalContentAlignment="Top" Margin="0,0,14,0"
                                     AutomationProperties.Name="跟随系统主题">
                            <StackPanel>
                                <TextBlock Text="跟随系统" FontWeight="SemiBold"/>
                                <TextBlock Text="与 Windows 的外观保持一致" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource Wam.TextSecondaryBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="LightThemeOption" Tag="Light" GroupName="AppTheme"
                                     Checked="OnThemeChecked" VerticalContentAlignment="Top" Margin="0,0,14,0"
                                     AutomationProperties.Name="浅色主题">
                            <StackPanel>
                                <TextBlock Text="浅色" FontWeight="SemiBold"/>
                                <TextBlock Text="明亮、简洁的浅色界面" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource Wam.TextSecondaryBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="DarkThemeOption" Tag="Dark" GroupName="AppTheme"
                                     Checked="OnThemeChecked" VerticalContentAlignment="Top"
                                     AutomationProperties.Name="深色主题">
                            <StackPanel>
                                <TextBlock Text="深色" FontWeight="SemiBold"/>
                                <TextBlock Text="柔和、舒适的深色界面" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource Wam.TextSecondaryBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                    <Border Background="{DynamicResource Wam.AccentSoftBrush}" CornerRadius="7"
                            Padding="12,10" Margin="0,20,0,0">
                        <TextBlock x:Name="ThemeStatusText" Foreground="{DynamicResource Wam.TextSecondaryBrush}"
                                   FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Wam.CardBorderStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="服务端地址" Style="{StaticResource Wam.SectionTitleTextBlockStyle}"/>
                    <TextBlock Text="客户端从这里获取软件目录、详情、图标和下载地址。默认连接在线服务端 https://winapps.theconsole.top/，也可以填写局域网或自建后端地址（http/https）。切换后软件目录会重新加载，已经开始的下载任务不受影响。"
                               Style="{StaticResource Wam.SecondaryTextBlockStyle}" Margin="0,7,0,0"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BackendBaseUrlTextBox" MinHeight="36" Padding="11,0"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.Name="服务端地址"/>
                        <Button x:Name="ApplyBackendButton" Grid.Column="1" Content="应用"
                                MinHeight="36" Padding="15,0" Margin="8,0,0,0"
                                Click="OnApplyBackendBaseUrl"
                                AutomationProperties.Name="应用服务端地址"/>
                        <Button x:Name="TestBackendButton" Grid.Column="2" Content="测试连接"
                                MinHeight="36" Padding="15,0" Margin="8,0,0,0"
                                Click="OnTestBackendBaseUrl"
                                AutomationProperties.Name="测试服务端连接"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="ResetBackendButton" Content="恢复默认" Padding="14,6"
                                Click="OnResetBackendBaseUrl"
                                AutomationProperties.Name="恢复默认服务端地址"/>
                    </StackPanel>
                    <TextBlock x:Name="BackendStatusText" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Wam.CardBorderStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="软件源" Style="{StaticResource Wam.SectionTitleTextBlockStyle}"/>
                    <TextBlock Text="软件源列表与当前可用状态由当前服务端决定（GET /api/v1/sources）。客户端不内置任何来源：服务端新增来源后会自动出现，切换来源会重新加载目录，已经开始的下载任务不受影响。"
                               Style="{StaticResource Wam.SecondaryTextBlockStyle}" Margin="0,7,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="软件源" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ComboBox x:Name="AppSourceCombo" Grid.Column="1" Width="228" MinHeight="36"
                                  VerticalAlignment="Center"
                                  VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                                  SelectionChanged="OnAppSourceChanged"
                                  AutomationProperties.Name="软件源"/>
                        <Button x:Name="RefreshSourcesButton" Grid.Column="2" Content="重新读取来源"
                                MinHeight="36" Padding="12,0" Margin="8,0,0,0"
                                Click="OnRefreshServerSources"
                                AutomationProperties.Name="重新读取服务端软件源列表"/>
                    </Grid>
                    <TextBlock Text="来源名称、默认来源、搜索方式与截图/视频/刷新等能力全部来自服务端；不可用的来源会标注并禁止选择。"
                               Style="{StaticResource Wam.SecondaryTextBlockStyle}" Margin="0,10,0,0"/>
                    <Border Background="{DynamicResource Wam.AccentSoftBrush}" CornerRadius="7"
                            Padding="12,10" Margin="0,16,0,0">
                        <TextBlock x:Name="AppSourceStatusText" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Wam.CardBorderStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="下载" Style="{StaticResource Wam.SectionTitleTextBlockStyle}"/>
                    <TextBlock Text="设置并发线程数、网络超时、下载位置和 GitHub 加速镜像。更改会自动保存，并用于之后开始的下载。"
                               Style="{StaticResource Wam.SecondaryTextBlockStyle}" Margin="0,7,0,0"/>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="下载线程数" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="{DynamicResource Wam.AccentSoftBrush}"
                                CornerRadius="5" Padding="9,3">
                            <TextBlock x:Name="DownloadConnectionsValueText" FontSize="12"
                                       Foreground="{DynamicResource Wam.AccentBrush}"/>
                        </Border>
                    </Grid>
                    <Slider x:Name="DownloadConnectionsSlider" Minimum="1" Maximum="32" TickFrequency="1"
                            SmallChange="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                            Margin="0,6,0,0" ValueChanged="OnDownloadConnectionsValueChanged"
                            AutomationProperties.Name="下载线程数"/>
                    <TextBlock Text="建议使用 4 个线程；增加线程数不一定能提高速度。服务器不支持分段时自动使用单连接。"
                               Style="{StaticResource Wam.SecondaryTextBlockStyle}" Margin="0,6,0,0"/>

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="下载超时" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="{DynamicResource Wam.AccentSoftBrush}"
                                CornerRadius="5" Padding="9,3">
                            <TextBlock x:Name="DownloadTimeoutValueText" FontSize="12"
                                       Foreground="{DynamicResource Wam.AccentBrush}"/>
                        </Border>
                    </Grid>
                    <Slider x:Name="DownloadTimeoutSlider" Minimum="10" Maximum="300"
                            TickFrequency="10" SmallChange="10"
                            IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                            Margin="0,6,0,0" ValueChanged="OnDownloadTimeoutValueChanged"
                            AutomationProperties.Name="下载超时秒数"/>
                    <TextBlock Text="连接下载服务器和每次读取数据的最长等待时间；超时后任务会停止并可在下载中心重试。"
                               Style="{StaticResource Wam.SecondaryTextBlockStyle}" Margin="0,6,0,0"/>

                    <TextBlock Text="GitHub 加速镜像" FontWeight="SemiBold" Margin="0,24,0,0"/>
                    <TextBlock Text="仅对 github.com、raw.githubusercontent.com 等 GitHub 下载链接生效。留空表示直连；使用第三方镜像会经过该服务器，应用仍会校验安装包。"
                               Style="{StaticResource Wam.SecondaryTextBlockStyle}" Margin="0,6,0,0"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="GitHubMirrorTextBox" MinHeight="36" Padding="11,0"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.Name="GitHub 镜像前缀"/>
                        <Button x:Name="ApplyGitHubMirrorButton" Grid.Column="1" Content="应用"
                                MinHeight="36" Padding="15,0" Margin="8,0,0,0"
                                Click="OnApplyGitHubMirror"/>
                    </Grid>
                    <ComboBox x:Name="GitHubMirrorPresetCombo" MinHeight="36" Margin="0,8,0,0"
                              HorizontalContentAlignment="Left"
                              SelectionChanged="OnGitHubMirrorPresetChanged"
                              AutomationProperties.Name="GitHub 镜像预设">
                        <ComboBoxItem Content="不使用（直连 GitHub）" Tag=""/>
                        <ComboBoxItem Content="gh-proxy.com" Tag="https://gh-proxy.com/"/>
                        <ComboBoxItem Content="ghfast.top" Tag="https://ghfast.top/"/>
                        <ComboBoxItem Content="ghproxy.net" Tag="https://ghproxy.net/"/>
                        <ComboBoxItem Content="ghp.ci" Tag="https://ghp.ci/"/>
                        <ComboBoxItem Content="gh.llkk.cc" Tag="https://gh.llkk.cc/"/>
                        <ComboBoxItem Content="mirror.ghproxy.com" Tag="https://mirror.ghproxy.com/"/>
                    </ComboBox>
                    <TextBlock x:Name="GitHubMirrorStatusText" FontSize="12" Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>

                    <TextBlock Text="下载位置" FontWeight="SemiBold" Margin="0,24,0,0"/>
                    <TextBlock Text="安装包保存到该文件夹；留空或点“恢复默认”时使用系统默认目录。更改只影响之后开始的下载，正在下载的任务保持原路径。"
                               Style="{StaticResource Wam.SecondaryTextBlockStyle}" Margin="0,6,0,0"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DownloadDirectoryTextBox" MinHeight="36" Padding="11,0"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.Name="下载目录"/>
                        <Button Grid.Column="1" Content="浏览…" MinHeight="36" Padding="14,0" Margin="8,0,0,0"
                                Click="OnBrowseDownloadDirectory"
                                AutomationProperties.Name="浏览下载目录"/>
                        <Button Grid.Column="2" Content="应用" MinHeight="36" Padding="15,0" Margin="8,0,0,0"
                                Click="OnApplyDownloadDirectory"
                                AutomationProperties.Name="应用下载目录"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="OpenDownloadDirectoryButton" Content="打开下载目录" Padding="12,5"
                                Click="OnOpenDownloadDirectory"
                                AutomationProperties.Name="打开下载目录"/>
                        <Button x:Name="ResetDownloadDirectoryButton" Content="恢复默认" Padding="12,5"
                                Margin="8,0,0,0" Click="OnResetDownloadDirectory"
                                AutomationProperties.Name="恢复默认下载目录"/>
                    </StackPanel>
                    <TextBlock x:Name="DownloadDirectoryStatusText" FontSize="12" Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>

                    <TextBlock x:Name="DownloadSummaryText" FontSize="12" Margin="0,14,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Wam.CardBorderStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="网络" Style="{StaticResource Wam.SectionTitleTextBlockStyle}"/>
                    <TextBlock Text="控制安装包下载使用的代理和 HTTPS 证书校验。设置用于之后开始的下载；正在下载的任务保持启动时的配置。"
                               Style="{StaticResource Wam.SecondaryTextBlockStyle}" Margin="0,7,0,16"/>

                    <StackPanel>
                        <RadioButton x:Name="SystemProxyOption" Tag="System" GroupName="DownloadProxy"
                                     Checked="OnProxyModeChecked" Margin="0,0,0,8"
                                     AutomationProperties.Name="跟随系统代理">
                            <TextBlock Text="跟随系统代理" FontWeight="SemiBold"/>
                        </RadioButton>
                        <RadioButton x:Name="DirectProxyOption" Tag="Direct" GroupName="DownloadProxy"
                                     Checked="OnProxyModeChecked" Margin="0,0,0,8"
                                     AutomationProperties.Name="直连下载">
                            <TextBlock Text="直连（不使用代理）" FontWeight="SemiBold"/>
                        </RadioButton>
                        <RadioButton x:Name="CustomProxyOption" Tag="Custom" GroupName="DownloadProxy"
                                     Checked="OnProxyModeChecked"
                                     AutomationProperties.Name="自定义代理">
                            <TextBlock Text="自定义代理" FontWeight="SemiBold"/>
                        </RadioButton>
                    </StackPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CustomProxyTextBox" MinHeight="36" Padding="11,0"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.Name="自定义代理地址"/>
                        <Button x:Name="SaveCustomProxyButton" Grid.Column="1" Content="保存代理"
                                MinHeight="36" Padding="15,0" Margin="8,0,0,0"
                                Click="OnSaveCustomProxy"/>
                    </Grid>
                    <TextBlock Text="示例：http://127.0.0.1:7890。仅支持 HTTP/HTTPS 代理，代理认证信息可写在地址中。"
                               Style="{StaticResource Wam.SecondaryTextBlockStyle}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="ProxyStatusText" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>

                    <Border Background="{DynamicResource Wam.SubtleBackgroundBrush}" CornerRadius="8"
                            Padding="12,10" Margin="0,18,0,0">
                        <StackPanel>
                            <CheckBox x:Name="IgnoreCertificateErrorsCheckBox"
                                      Content="忽略安装包下载的 HTTPS 证书错误"
                                      Checked="OnIgnoreCertificateErrorsChanged"
                                      Unchecked="OnIgnoreCertificateErrorsChanged"
                                      AutomationProperties.Name="忽略证书错误"/>
                            <TextBlock x:Name="CertificateWarningText" FontSize="12" Margin="0,7,0,0"
                                       TextWrapping="Wrap"
                                       Text="危险：跳过证书校验可能让下载内容被篡改。只应在本地调试或明确信任网络环境时启用。"
                                       Foreground="{DynamicResource Wam.DangerBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Wam.CardBorderStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="设置存储" Style="{StaticResource Wam.SectionTitleTextBlockStyle}"/>
                    <TextBlock Text="外观和下载偏好保存在当前 Windows 用户的本地目录中。"
                               Style="{StaticResource Wam.SecondaryTextBlockStyle}" Margin="0,7,0,14"/>
                    <TextBox x:Name="SettingsPathTextBox" IsReadOnly="True" TextWrapping="Wrap"
                             Padding="11,9" AutomationProperties.Name="设置文件路径"/>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="复制路径" Click="OnCopySettingsPath" Padding="15,7" Margin="0,0,10,0"/>
                        <Button Content="打开文件夹" Click="OnOpenSettingsDirectory" Padding="15,7"/>
                    </WrapPanel>
                    <TextBlock x:Name="ActionStatusText" Style="{StaticResource Wam.SecondaryTextBlockStyle}"
                               Visibility="Collapsed" Margin="0,12,0,0"/>

                    <Border Height="1" Background="{DynamicResource Wam.CardBorderBrush}" Margin="0,20,0,0"/>
                    <TextBlock Text="日志" Style="{StaticResource Wam.SectionTitleTextBlockStyle}" Margin="0,18,0,0"/>
                    <TextBlock Text="日志写到当前用户本地目录，用于排查问题；不记录下载链接和敏感配置。"
                               Style="{StaticResource Wam.SecondaryTextBlockStyle}" Margin="0,7,0,14"/>
                    <TextBox x:Name="LogPathTextBox" IsReadOnly="True" TextWrapping="Wrap"
                             Padding="11,9" AutomationProperties.Name="日志文件路径"/>
                    <WrapPanel Margin="0,14,0,0">
                        <Button x:Name="OpenLogFolderButton" Content="打开日志目录" Click="OnOpenLogFolder"
                                Padding="15,7" Margin="0,0,10,0"
                                AutomationProperties.Name="打开日志目录"/>
                        <Button x:Name="CopyLogPathButton" Content="复制路径" Click="OnCopyLogPath"
                                Padding="15,7" AutomationProperties.Name="复制日志目录路径"/>
                    </WrapPanel>
                    <Border Background="{DynamicResource Wam.SubtleBackgroundBrush}" CornerRadius="8"
                            Padding="12,10" Margin="0,14,0,0">
                        <StackPanel>
                            <CheckBox x:Name="EnableFileLoggingCheckBox" Content="启用文件日志"
                                      Checked="OnEnableFileLoggingChanged" Unchecked="OnEnableFileLoggingChanged"
                                      AutomationProperties.Name="启用文件日志"/>
                            <TextBlock Text="关闭后不再写入日志文件，只在调试器中保留输出；排查问题后建议重新开启。"
                                       Style="{StaticResource Wam.SecondaryTextBlockStyle}"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <CheckBox x:Name="VerboseLoggingCheckBox" Content="记录详细日志（Verbose）"
                                      Checked="OnVerboseLoggingChanged" Unchecked="OnVerboseLoggingChanged"
                                      Margin="0,14,0,0" AutomationProperties.Name="记录详细日志"/>
                            <TextBlock Text="记录更细的调试信息，日志文件增长更快；仅在排查问题时开启，关闭文件日志时该选项不生效。"
                                       Style="{StaticResource Wam.SecondaryTextBlockStyle}"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="LogStatusText" Style="{StaticResource Wam.SecondaryTextBlockStyle}"
                               Margin="0,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Wam.CardBorderStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="缓存" Style="{StaticResource Wam.SectionTitleTextBlockStyle}"/>
                    <TextBlock Text="软件资料缓存 5 分钟；网络不可用时可显示 24 小时内的缓存。图标保存在本机，清理后重新获取。"
                               Style="{StaticResource Wam.SecondaryTextBlockStyle}" Margin="0,7,0,14"/>
                    <TextBlock x:Name="CacheStatusText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock x:Name="CacheFilesText" Style="{StaticResource Wam.SecondaryTextBlockStyle}"/>
                    <TextBox x:Name="CachePathTextBox" IsReadOnly="True" TextWrapping="Wrap" Padding="11,9" Margin="0,14,0,0"
                             AutomationProperties.Name="缓存目录"/>
                    <Button x:Name="ClearCacheButton" Content="清理目录与图标缓存" Click="OnClearCache" Padding="15,8"
                            HorizontalAlignment="Left" Margin="0,14,0,0"/>
                    <TextBlock x:Name="CacheActionStatusText" Style="{StaticResource Wam.SecondaryTextBlockStyle}"
                               Visibility="Collapsed" Margin="0,12,0,0"/>
                    <TextBlock x:Name="CacheWarningText" Style="{StaticResource Wam.SecondaryTextBlockStyle}"
                               Visibility="Collapsed" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Wam.CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="关于应用" Style="{StaticResource Wam.SectionTitleTextBlockStyle}"/>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="应用名称" Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="WinAppsManager" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Text="应用版本" Foreground="{DynamicResource Wam.TextSecondaryBrush}" Margin="0,13,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="VersionText" Margin="0,13,0,0"/>
                        <TextBlock Grid.Row="2" Text="软件目录" Foreground="{DynamicResource Wam.TextSecondaryBrush}" Margin="0,13,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CatalogCountText" Margin="0,13,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ui:Page>
