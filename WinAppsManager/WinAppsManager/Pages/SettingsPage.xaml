<ui:Page x:Class="WinAppsManager.Pages.SettingsPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
         Background="{DynamicResource Wam.PageBackgroundBrush}"
         Foreground="{DynamicResource Wam.TextPrimaryBrush}"
         Title="设置"
         Loaded="OnPageLoaded"
         Unloaded="OnPageUnloaded">

    <Page.Resources>
        <!-- 分组标题样式 -->
        <Style x:Key="SettingsGroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Wam.TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="2,22,0,10"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- 内容上限放宽到 1120：导航栏收起后内容区变宽，旧的 860 会让整页居中、两侧出现大片空白。 -->
        <StackPanel Margin="32,24,32,40" MaxWidth="1120" HorizontalAlignment="Stretch">
            <!-- 页头 -->
            <TextBlock Text="设置" Style="{StaticResource Wam.PageTitleTextBlockStyle}"/>
            <TextBlock Text="自定义界面外观、软件源与下载网络偏好。"
                       Style="{StaticResource Wam.SecondaryTextBlockStyle}" Margin="0,6,0,16"/>

            <!-- 全局错误/保存提示条 -->
            <ui:InfoBar x:Name="SettingsErrorBar"
                        Title="设置保存提示"
                        Severity="Warning"
                        IsClosable="False"
                        IsOpen="False"
                        Margin="0,0,0,12">
                <ui:InfoBar.ActionButton>
                    <Button Content="重新保存" Click="OnRetrySaveSettings"/>
                </ui:InfoBar.ActionButton>
            </ui:InfoBar>

            <!-- ==================== 1. 个性化 ==================== -->
            <TextBlock Text="个性化" Style="{StaticResource SettingsGroupHeaderStyle}" Margin="2,4,0,10"/>

            <!-- 颜色模式 -->
            <ui:SettingsCard Header="颜色模式"
                             Description="选择应用的浅色或深色外观，更改立即生效"
                             Margin="0,0,0,8">
                <ui:SettingsCard.HeaderIcon>
                    <!-- 背景图标一律使用应用内置的 Fluent 图标字体（ui:FontIcon）：ui:SymbolIcon 依赖
                         Segoe Fluent Icons / Segoe MDL2 Assets，Windows 7 及精简系统上会显示成方框。 -->
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.TextColor_20_Regular}"/>
                </ui:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ThemeModeCombo"
                          Width="205"
                          SelectionChanged="OnThemeComboSelectionChanged"
                          AutomationProperties.Name="选择颜色模式">
                    <ComboBoxItem Tag="System">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="14" Height="14" CornerRadius="3" ClipToBounds="True"
                                    BorderBrush="{DynamicResource Wam.CardBorderBrush}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#F5F7FA"/>
                                    <Border Grid.Column="1" Background="#1E222A"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="跟随系统" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="Light">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="14" Height="14" CornerRadius="3"
                                    Background="#F5F7FA" BorderBrush="#CBD5E1" BorderThickness="1"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="浅色模式" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="Dark">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="14" Height="14" CornerRadius="3"
                                    Background="#1E222A" BorderBrush="#475569" BorderThickness="1"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="深色模式" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ComboBoxItem>
                </ComboBox>
            </ui:SettingsCard>

            <!-- 窗口背景（系统级亚克力 / 云母，按系统能力启用） -->
            <ui:SettingsCard x:Name="BackdropStyleCard"
                             Header="窗口背景"
                             Description="导航栏与标题栏的透明效果，更改立即生效"
                             Margin="0,0,0,8">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ViewDesktop_20_Regular}"/>
                </ui:SettingsCard.HeaderIcon>
                <StackPanel VerticalAlignment="Center">
                    <ComboBox x:Name="BackdropStyleCombo"
                              Width="205"
                              SelectionChanged="OnBackdropStyleComboSelectionChanged"
                              AutomationProperties.Name="选择窗口背景风格">
                        <ComboBoxItem Tag="None" Content="无（不透明）"/>
                        <ComboBoxItem Tag="Acrylic" Content="亚克力"
                                      x:Name="AcrylicBackdropItem"
                                      ToolTip="Windows 10 1803 及以上可用"/>
                        <ComboBoxItem Tag="Mica" Content="云母"
                                      x:Name="MicaBackdropItem"
                                      ToolTip="Windows 11 22H2 及以上可用"/>
                        <ComboBoxItem Tag="Auto" Content="自动（跟随系统）"/>
                    </ComboBox>
                </StackPanel>
            </ui:SettingsCard>

            <!-- 主题色：ComboBox 预设选择 + 内联自定义取色浮层 -->
            <ui:SettingsCard Header="主题色"
                             Description="应用于主按钮、选中框与进度条，深色模式下自动调整明度"
                             Margin="0,0,0,8">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Highlight_20_Regular}"/>
                </ui:SettingsCard.HeaderIcon>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="AccentColorCombo"
                              Width="205"
                              SelectionChanged="OnAccentComboSelectionChanged"
                              AutomationProperties.Name="选择主题色"/>

                    <ui:DropDownButton x:Name="CustomAccentDropDownButton"
                                       Content="自定义…"
                                       Margin="8,0,0,0"
                                       ToolTip="打开调色盘选择任意颜色"
                                       AutomationProperties.Name="自定义主题色">
                        <ui:DropDownButton.Flyout>
                            <ui:Flyout x:Name="CustomAccentFlyout"
                                       Placement="BottomEdgeAlignedRight"
                                       Opened="OnCustomAccentFlyoutOpened"
                                       Closed="OnCustomAccentFlyoutClosed">
                                <StackPanel Width="264">
                                    <StackPanel.Resources>
                                        <ResourceDictionary>
                                            <ResourceDictionary.MergedDictionaries>
                                                <ResourceDictionary Source="pack://application:,,,/ColorPicker;component/Styles/DefaultColorPickerStyle.xaml"/>
                                            </ResourceDictionary.MergedDictionaries>
                                        </ResourceDictionary>
                                    </StackPanel.Resources>

                                    <colorpicker:StandardColorPicker x:Name="InlineAccentColorPicker"
                                                                     Width="264"
                                                                     Height="340"
                                                                     ShowAlpha="False"
                                                                     ColorChanged="OnInlineColorPickerChanged"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                        <Button x:Name="CancelCustomAccentButton"
                                                Content="取消" Padding="12,5" Margin="0,0,8,0"
                                                Click="OnCancelCustomAccentClick"/>
                                        <Button x:Name="ApplyCustomAccentButton"
                                                Content="应用" Padding="14,5"
                                                Style="{DynamicResource AccentButtonStyle}"
                                                Click="OnApplyCustomAccentClick"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:Flyout>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>

                    <Button x:Name="ResetAccentButton"
                            Content="恢复默认"
                            Margin="6,0,0,0"
                            Visibility="Collapsed"
                            Click="OnResetAccentClick"
                            ToolTip="恢复为默认主题蓝"/>
                </StackPanel>
            </ui:SettingsCard>

            <!-- 背景图（折叠低频项，右侧展示状态摘要） -->
            <ui:SettingsExpander x:Name="BackgroundExpander"
                                 Header="自定义背景图"
                                 Description="使用本地图片铺满窗口底色（支持 PNG / JPG / BMP / GIF）"
                                 IsExpanded="False">
                <ui:SettingsExpander.HeaderIcon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ImageMultiple_20_Regular}"/>
                </ui:SettingsExpander.HeaderIcon>
                <ui:SettingsExpander.Content>
                    <TextBlock x:Name="BackgroundSummaryText"
                               FontSize="12"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </ui:SettingsExpander.Content>
                <ui:SettingsExpander.Items>
                    <ui:SettingsCard Header="图片文件">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="BackgroundImageBox" Width="240" IsReadOnly="True"
                                     VerticalContentAlignment="Center" FontSize="12"
                                     AutomationProperties.Name="当前背景图路径"/>
                            <Button Content="浏览…" Margin="8,0,0,0" Click="OnBrowseBackgroundImage"
                                    AutomationProperties.Name="选择背景图"/>
                            <Button x:Name="ClearBackgroundButton" Content="清除" Margin="6,0,0,0"
                                    Click="OnClearBackgroundImage"
                                    AutomationProperties.Name="恢复纯色背景"/>
                        </StackPanel>
                    </ui:SettingsCard>
                    <ui:SettingsCard Header="背景不透明度" Description="调低不透明度可提升卡片文字对比度">
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="BackgroundOpacitySlider" Width="180"
                                    Minimum="5" Maximum="100" TickFrequency="1" SmallChange="1"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="OnBackgroundOpacityChanged"
                                    AutomationProperties.Name="背景图不透明度"/>
                            <TextBlock x:Name="BackgroundOpacityText" Width="44" TextAlignment="Right"
                                       FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                        </StackPanel>
                    </ui:SettingsCard>
                </ui:SettingsExpander.Items>
            </ui:SettingsExpander>

            <!-- ==================== 2. 服务与软件源 ==================== -->
            <TextBlock Text="服务与软件源" Style="{StaticResource SettingsGroupHeaderStyle}"/>

            <ui:SettingsCard Header="软件源" Description="可用来源与目录能力由当前服务端动态下发" Margin="0,0,0,8">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Globe_20_Regular}"/>
                </ui:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="AppSourceCombo" Width="210"
                              SelectionChanged="OnAppSourceChanged"
                              AutomationProperties.Name="软件源"/>
                    <Button x:Name="RefreshSourcesButton" Margin="8,0,0,0"
                            Click="OnRefreshServerSources"
                            ToolTip="重新从服务端读取软件源列表"
                            AutomationProperties.Name="重新读取服务端软件源列表">
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ArrowClockwise_20_Regular}"/>
                    </Button>
                </StackPanel>
            </ui:SettingsCard>
            <TextBlock x:Name="AppSourceStatusText" FontSize="12" Margin="4,0,4,10" TextWrapping="Wrap"
                       Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>

            <ui:SettingsExpander Header="服务端地址"
                                 Description="获取软件目录、详情与下载地址的后端 API 端点"
                                 IsExpanded="False">
                <ui:SettingsExpander.HeaderIcon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Link_20_Regular}"/>
                </ui:SettingsExpander.HeaderIcon>
                <ui:SettingsExpander.Content>
                    <TextBlock x:Name="BackendSummaryText" FontSize="12"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </ui:SettingsExpander.Content>
                <ui:SettingsExpander.Items>
                    <ui:SettingsCard Header="API 基地址" Description="支持 http/https，切换后会清空当前目录缓存">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="BackendBaseUrlTextBox" Width="250"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.Name="服务端地址"/>
                            <Button x:Name="ApplyBackendButton" Content="应用"
                                    Style="{DynamicResource AccentButtonStyle}"
                                    Margin="8,0,0,0" Click="OnApplyBackendBaseUrl"
                                    AutomationProperties.Name="应用服务端地址"/>
                            <Button x:Name="TestBackendButton" Content="测试" Margin="6,0,0,0"
                                    Click="OnTestBackendBaseUrl"
                                    AutomationProperties.Name="测试服务端连接"/>
                            <Button x:Name="ResetBackendButton" Content="默认" Margin="6,0,0,0"
                                    Click="OnResetBackendBaseUrl"
                                    AutomationProperties.Name="恢复默认服务端地址"/>
                        </StackPanel>
                    </ui:SettingsCard>
                    <ui:SettingsCard>
                        <ui:SettingsCard.Header>
                            <TextBlock x:Name="BackendStatusText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                        </ui:SettingsCard.Header>
                    </ui:SettingsCard>
                </ui:SettingsExpander.Items>
            </ui:SettingsExpander>

            <!-- ==================== 3. 下载与网络 ==================== -->
            <TextBlock Text="下载与网络" Style="{StaticResource SettingsGroupHeaderStyle}"/>

            <ui:SettingsCard Header="下载位置" Description="新下载的安装包将保存到此文件夹" Margin="0,0,0,8">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Folder_20_Regular}"/>
                </ui:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="DownloadDirectoryTextBox" Width="230"
                             VerticalContentAlignment="Center"
                             AutomationProperties.Name="下载目录"/>
                    <Button Content="浏览…" Margin="6,0,0,0" Click="OnBrowseDownloadDirectory"
                            AutomationProperties.Name="浏览下载目录"/>
                    <Button Content="应用" Margin="6,0,0,0" Click="OnApplyDownloadDirectory"
                            AutomationProperties.Name="应用下载目录"/>
                    <Button x:Name="OpenDownloadDirectoryButton" Margin="6,0,0,0"
                            Click="OnOpenDownloadDirectory" ToolTip="在资源管理器中打开"
                            AutomationProperties.Name="打开下载目录">
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.FolderOpen_20_Regular}"/>
                    </Button>
                    <Button x:Name="ResetDownloadDirectoryButton" Content="默认" Margin="6,0,0,0"
                            Click="OnResetDownloadDirectory"
                            AutomationProperties.Name="恢复默认下载目录"/>
                </StackPanel>
            </ui:SettingsCard>
            <TextBlock x:Name="DownloadDirectoryStatusText" FontSize="12" Margin="4,0,4,10" TextWrapping="Wrap"
                       Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>

            <!-- 下载传输参数（折叠摘要） -->
            <ui:SettingsExpander Header="并发与超时"
                                 Description="调整单任务分段线程数与网络读取超时时间"
                                 IsExpanded="False"
                                 Margin="0,0,0,8">
                <ui:SettingsExpander.HeaderIcon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ArrowDownload_20_Regular}"/>
                </ui:SettingsExpander.HeaderIcon>
                <ui:SettingsExpander.Content>
                    <TextBlock x:Name="DownloadPerfSummaryText" FontSize="12"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </ui:SettingsExpander.Content>
                <ui:SettingsExpander.Items>
                    <ui:SettingsCard Header="下载线程数" Description="建议 4 线程；服务器不支持分段时自动回退单连接">
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="DownloadConnectionsSlider" Width="180"
                                    Minimum="1" Maximum="32" TickFrequency="1" SmallChange="1"
                                    IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                    VerticalAlignment="Center"
                                    ValueChanged="OnDownloadConnectionsValueChanged"
                                    AutomationProperties.Name="下载线程数"/>
                            <Border Background="{DynamicResource Wam.AccentSoftBrush}"
                                    CornerRadius="5" Padding="8,3" Margin="10,0,0,0">
                                <TextBlock x:Name="DownloadConnectionsValueText" FontSize="12"
                                           Foreground="{DynamicResource Wam.AccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </ui:SettingsCard>
                    <ui:SettingsCard Header="读取超时时间" Description="单次网络请求或读取数据的最长等待秒数">
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="DownloadTimeoutSlider" Width="180"
                                    Minimum="10" Maximum="300" TickFrequency="10" SmallChange="10"
                                    IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                    VerticalAlignment="Center"
                                    ValueChanged="OnDownloadTimeoutValueChanged"
                                    AutomationProperties.Name="下载超时秒数"/>
                            <Border Background="{DynamicResource Wam.AccentSoftBrush}"
                                    CornerRadius="5" Padding="8,3" Margin="10,0,0,0">
                                <TextBlock x:Name="DownloadTimeoutValueText" FontSize="12"
                                           Foreground="{DynamicResource Wam.AccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </ui:SettingsCard>
                </ui:SettingsExpander.Items>
            </ui:SettingsExpander>

            <!-- GitHub 加速镜像（折叠摘要） -->
            <ui:SettingsExpander Header="GitHub 加速镜像"
                                 Description="仅为 github.com 下载链接配置反代前缀，安装包仍会执行哈希校验"
                                 IsExpanded="False"
                                 Margin="0,0,0,8">
                <ui:SettingsExpander.HeaderIcon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ArrowSync_20_Regular}"/>
                </ui:SettingsExpander.HeaderIcon>
                <ui:SettingsExpander.Content>
                    <TextBlock x:Name="GitHubMirrorSummaryText" FontSize="12"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </ui:SettingsExpander.Content>
                <ui:SettingsExpander.Items>
                    <ui:SettingsCard Header="常用预设">
                        <ComboBox x:Name="GitHubMirrorPresetCombo" Width="240"
                                  SelectionChanged="OnGitHubMirrorPresetChanged"
                                  AutomationProperties.Name="GitHub 镜像预设">
                            <ComboBoxItem Content="不使用（直连 GitHub）" Tag=""/>
                            <ComboBoxItem Content="gh-proxy.com" Tag="https://gh-proxy.com/"/>
                            <ComboBoxItem Content="ghfast.top" Tag="https://ghfast.top/"/>
                            <ComboBoxItem Content="ghproxy.net" Tag="https://ghproxy.net/"/>
                            <ComboBoxItem Content="ghp.ci" Tag="https://ghp.ci/"/>
                            <ComboBoxItem Content="gh.llkk.cc" Tag="https://gh.llkk.cc/"/>
                            <ComboBoxItem Content="mirror.ghproxy.com" Tag="https://mirror.ghproxy.com/"/>
                        </ComboBox>
                    </ui:SettingsCard>
                    <ui:SettingsCard Header="自定义镜像前缀" Description="留空表示直连，支持 http/https">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="GitHubMirrorTextBox" Width="240"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.Name="GitHub 镜像前缀"/>
                            <Button x:Name="ApplyGitHubMirrorButton" Content="应用"
                                    Margin="8,0,0,0" Click="OnApplyGitHubMirror"/>
                        </StackPanel>
                    </ui:SettingsCard>
                    <ui:SettingsCard>
                        <ui:SettingsCard.Header>
                            <TextBlock x:Name="GitHubMirrorStatusText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                        </ui:SettingsCard.Header>
                    </ui:SettingsCard>
                </ui:SettingsExpander.Items>
            </ui:SettingsExpander>

            <!-- 网络代理与证书安全（折叠摘要） -->
            <ui:SettingsExpander Header="网络代理与证书校验"
                                 Description="配置下载使用的 HTTP/HTTPS 代理服务器及 TLS 校验策略"
                                 IsExpanded="False">
                <ui:SettingsExpander.HeaderIcon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ShieldKeyhole_20_Regular}"/>
                </ui:SettingsExpander.HeaderIcon>
                <ui:SettingsExpander.Content>
                    <TextBlock x:Name="ProxySummaryText" FontSize="12"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </ui:SettingsExpander.Content>
                <ui:SettingsExpander.Items>
                    <ui:SettingsCard Header="代理模式">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="SystemProxyOption" Tag="System" GroupName="DownloadProxy"
                                         Content="跟随系统" Checked="OnProxyModeChecked" Margin="0,0,14,0"
                                         AutomationProperties.Name="跟随系统代理"/>
                            <RadioButton x:Name="DirectProxyOption" Tag="Direct" GroupName="DownloadProxy"
                                         Content="直连" Checked="OnProxyModeChecked" Margin="0,0,14,0"
                                         AutomationProperties.Name="直连下载"/>
                            <RadioButton x:Name="CustomProxyOption" Tag="Custom" GroupName="DownloadProxy"
                                         Content="自定义" Checked="OnProxyModeChecked"
                                         AutomationProperties.Name="自定义代理"/>
                        </StackPanel>
                    </ui:SettingsCard>
                    <ui:SettingsCard x:Name="CustomProxyCard" Header="代理服务器地址"
                                     Description="示例：http://127.0.0.1:7890">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="CustomProxyTextBox" Width="230"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.Name="自定义代理地址"/>
                            <Button x:Name="SaveCustomProxyButton" Content="保存"
                                    Margin="8,0,0,0" Click="OnSaveCustomProxy"/>
                        </StackPanel>
                    </ui:SettingsCard>
                    <ui:SettingsCard Header="忽略 HTTPS 证书错误"
                                     Description="跳过安装包下载的 TLS 证书有效性验证">
                        <ui:ToggleSwitch x:Name="IgnoreCertificateErrorsSwitch"
                                         OnContent="开启" OffContent="关闭"
                                         Toggled="OnIgnoreCertificateErrorsToggled"
                                         AutomationProperties.Name="忽略证书错误"/>
                    </ui:SettingsCard>
                    <ui:SettingsCard>
                        <ui:SettingsCard.Header>
                            <StackPanel>
                                <TextBlock x:Name="ProxyStatusText" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                                <ui:InfoBar x:Name="CertificateWarningBar"
                                            Title="安全警告"
                                            Message="跳过证书校验可能导致下载内容被中间人篡改，仅建议在本地调试时启用。"
                                            Severity="Error"
                                            IsClosable="False"
                                            IsOpen="False"
                                            Margin="0,8,0,0"/>
                            </StackPanel>
                        </ui:SettingsCard.Header>
                    </ui:SettingsCard>
                </ui:SettingsExpander.Items>
            </ui:SettingsExpander>

            <!-- ==================== 4. 存储与诊断 ==================== -->
            <TextBlock Text="存储与诊断" Style="{StaticResource SettingsGroupHeaderStyle}"/>

            <!-- 本地缓存 -->
            <ui:SettingsCard Header="目录与图标缓存" Margin="0,0,0,8">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Delete_20_Regular}"/>
                </ui:SettingsCard.HeaderIcon>
                <ui:SettingsCard.Description>
                    <StackPanel>
                        <TextBlock x:Name="CacheStatusText" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                        <TextBlock x:Name="CacheFilesText" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                    </StackPanel>
                </ui:SettingsCard.Description>
                <Button x:Name="ClearCacheButton" Content="清理缓存" Click="OnClearCache"/>
            </ui:SettingsCard>
            <TextBlock x:Name="CacheActionStatusText" FontSize="12" Margin="4,0,4,8"
                       Visibility="Collapsed" TextWrapping="Wrap"
                       Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
            <TextBlock x:Name="CacheWarningText" FontSize="12" Margin="4,0,4,8"
                       Visibility="Collapsed" TextWrapping="Wrap"
                       Foreground="{DynamicResource Wam.DangerBrush}"/>

            <!-- 配置文件与运行日志（折叠高级诊断项） -->
            <ui:SettingsExpander Header="日志与配置文件"
                                 Description="管理本地 settings.json 与故障排查日志输出级别"
                                 IsExpanded="False">
                <ui:SettingsExpander.HeaderIcon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Document_20_Regular}"/>
                </ui:SettingsExpander.HeaderIcon>
                <ui:SettingsExpander.Content>
                    <TextBlock x:Name="LogSummaryText" FontSize="12"
                               Foreground="{DynamicResource Wam.TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </ui:SettingsExpander.Content>
                <ui:SettingsExpander.Items>
                    <ui:SettingsCard Header="启用文件日志" Description="关闭后仅向调试器输出，不再写入磁盘">
                        <ui:ToggleSwitch x:Name="EnableFileLoggingSwitch"
                                         OnContent="开启" OffContent="关闭"
                                         Toggled="OnEnableFileLoggingToggled"
                                         AutomationProperties.Name="启用文件日志"/>
                    </ui:SettingsCard>
                    <ui:SettingsCard Header="详细调试日志（Verbose）" Description="记录更细粒度的请求与状态信息">
                        <ui:ToggleSwitch x:Name="VerboseLoggingSwitch"
                                         OnContent="开启" OffContent="关闭"
                                         Toggled="OnVerboseLoggingToggled"
                                         AutomationProperties.Name="记录详细日志"/>
                    </ui:SettingsCard>
                    <ui:SettingsCard Header="日志目录">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="LogPathTextBox" Width="250" IsReadOnly="True" FontSize="12"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.Name="日志文件路径"/>
                            <Button x:Name="CopyLogPathButton" Content="复制" Margin="6,0,0,0"
                                    Click="OnCopyLogPath"/>
                            <Button x:Name="OpenLogFolderButton" Content="打开" Margin="6,0,0,0"
                                    Click="OnOpenLogFolder"/>
                        </StackPanel>
                    </ui:SettingsCard>
                    <ui:SettingsCard Header="配置文件路径">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="SettingsPathTextBox" Width="250" IsReadOnly="True" FontSize="12"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.Name="设置文件路径"/>
                            <Button Content="复制" Margin="6,0,0,0" Click="OnCopySettingsPath"/>
                            <Button Content="打开" Margin="6,0,0,0" Click="OnOpenSettingsDirectory"/>
                        </StackPanel>
                    </ui:SettingsCard>
                    <ui:SettingsCard>
                        <ui:SettingsCard.Header>
                            <StackPanel>
                                <TextBlock x:Name="LogStatusText" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Wam.TextSecondaryBrush}"/>
                                <TextBlock x:Name="ActionStatusText" FontSize="12" Margin="0,4,0,0"
                                           Visibility="Collapsed" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Wam.AccentBrush}"/>
                            </StackPanel>
                        </ui:SettingsCard.Header>
                    </ui:SettingsCard>
                </ui:SettingsExpander.Items>
            </ui:SettingsExpander>

            <!-- ==================== 5. 关于 ==================== -->
            <TextBlock Text="关于" Style="{StaticResource SettingsGroupHeaderStyle}"/>

            <ui:SettingsCard Header="WinAppsManager" Description="Windows 应用商店与安装包管理工具">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.QuestionCircle_20_Regular}"/>
                </ui:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Wam.SubtleBackgroundBrush}"
                            CornerRadius="5" Padding="9,4" Margin="0,0,8,0">
                        <TextBlock x:Name="VersionText" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="{DynamicResource Wam.AccentSoftBrush}"
                            CornerRadius="5" Padding="9,4">
                        <TextBlock x:Name="CatalogCountText" FontSize="12"
                                   Foreground="{DynamicResource Wam.AccentBrush}"/>
                    </Border>
                </StackPanel>
            </ui:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</ui:Page>