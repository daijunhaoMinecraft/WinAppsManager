<Project>
  <!--
    发布信息集中在这里维护：
    - 修改 Version 后提交，并推送 v<Version> 标签（或手动运行 Release workflow）。
    - Release workflow 会读取本文件和 Release.md，创建或覆盖对应的 GitHub Release。
    - Version 同时被 WinAppsManager.csproj 导入，作为客户端程序集版本，无需再改 csproj。
    - ReleaseTitle 支持 {tag} / {version} 占位符；ReleaseLatest 控制是否标记为 Latest。
  -->
  <PropertyGroup>
    <Version>1.3.0</Version>
    <ReleaseTagPrefix>v</ReleaseTagPrefix>
    <ReleaseTitle>WinAppsManager {tag}</ReleaseTitle>
    <ReleaseNotesFile>Release.md</ReleaseNotesFile>
    <ReleaseLatest>true</ReleaseLatest>
  </PropertyGroup>
</Project>
